#!/usr/bin/env bash
# G03 end-to-end entry point (bead ffw-xvv): the fsonos compatibility adapter.
# Delegates to tests/g03/run_cases.py (offline, stdlib Python; it builds and boots nothing and opens no network).
#
#   scripts/e2e/g03                              the full tier with no Rust evidence: the offline checks run, every Rust case is BLOCKED
#   scripts/e2e/g03 --judge LOG [LOG ...]        judge the centrally run cargo test output
#   scripts/e2e/g03 --tier smoke|full|soak --judge LOG [--receipts DIR]
#   scripts/e2e/g03 --list                       planned case ids
#   scripts/e2e/g03 --measure /path/to/frankensonos
#                                                additionally re-measure the usage matrix from a checkout, read only, and fail if it
#                                                differs from the recorded one
#
# The offline half is the independent reference model against the golden vectors (tests/g03/reference.py --check), the recorded usage
# matrix, and every tests/g03/test_*.py model check (tier full). Each runs as a bounded subprocess.
#
# The Rust half is the unit tests of franken-control's fsonos modules, one case per invariant in tests/g03/cases.json plus the Rust vector
# replay and any test no invariant names. They run only through the centralized RCH path; this script never invokes cargo:
#   RCH_REQUIRE_REMOTE=1 rch exec --source-content-receipt -- cargo test -p franken-control --locked
#   (add `-- --nocapture` to read a failure's first causal event from the live stderr; the failure block is read either way)
#
# Every run writes a JSONL diagnostic log through the shared Q00 sink (next to the receipt with --receipts); a run whose log lost critical
# evidence is NOT QUALIFIED. A run that is not a pass prints how to replay it, its versions and artifact digests.
#
# Exit 0 only when every case passed, none is blocked and the diagnostic log is complete; 1 on a failed case or a log that lost critical
# evidence; 3 when the only non-passes are blocked cases (missing Rust evidence is reported, never counted as passed); 4 for the soak tier
# (not run); 2 on usage errors.
#
# A qualified run is NOT a client claim: an actual fsonos controller against this endpoint is the open gate in docs/contracts/g03.md
# section 11.1, printed as OPEN on every run. No fixture, replay or model stands in for it.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
if [ "$#" -eq 0 ]; then
  set -- --tier full
fi
exec python3 -B "$ROOT/tests/g03/run_cases.py" "$@"
