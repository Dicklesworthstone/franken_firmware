#!/usr/bin/env python3
"""Q00 acceptance entry point (bead ffw-2qz).

Runs the Q00 registry (`scripts/test/q00.suite.json`: the independent-oracle canaries and
their paired positives) through `run-suite`, with the registry floor derived independently
from the oracles themselves, then re-verifies the finished receipt stream a second time
with `receipts.py verify`.  Exit 0 only if all three steps succeed:

  1. scripts/test/q00/floor.py emit      -> expected.json + required.json, from oracles.DEFECTS
  2. scripts/test/run-suite run --floor  -> <root>/<run-id>/receipts.jsonl
  3. scripts/test/test_support/receipts.py verify --expected --require   (separate process)

The floor comes from a source the manifest cannot edit, so a case removed from BOTH the
manifest's `cases` and its `required_cases` still fails here.

What a pass means: every planted defect was caught by exactly its own oracle and violation
kind, and every paired good run was accepted, in in-process host-simulation models.  It does
not say the oracles are right for a real device, and physical/provider evidence classes are
never produced here.

(The previous contents of this path, a four-line redirect to
`scripts/test/run-workspace-verification.py q00`, are preserved under
`.local-real/coordination/e2e-q00-agy-195ac897e4d6.sh`; that checker is still runnable directly.)

Usage: scripts/e2e/q00 --tier smoke|full [--artifact-root DIR] [--run-id ID] [--seed N]
"""
from __future__ import annotations

import argparse
import datetime
import os
import secrets
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
REPO = os.path.dirname(os.path.dirname(HERE))
TEST = os.path.join(REPO, "scripts", "test")
RUNNER = os.path.join(TEST, "run-suite")
FLOOR = os.path.join(TEST, "q00", "floor.py")
RECEIPTS = os.path.join(TEST, "test_support", "receipts.py")
MANIFEST = os.path.join(TEST, "q00.suite.json")


def step(label: str, argv: list) -> int:
    print("== %s" % label, flush=True)
    rc = subprocess.run([sys.executable, "-B"] + argv, stdin=subprocess.DEVNULL).returncode
    print("== %s -> exit %d" % (label, rc), flush=True)
    return rc


def main() -> int:
    ap = argparse.ArgumentParser(description="Q00 acceptance: independent floor -> run-suite -> independent re-verification")
    ap.add_argument("--tier", required=True, choices=("smoke", "full"), help="explicit; there is no default")
    ap.add_argument("--artifact-root", default=os.environ.get("FFW_ARTIFACT_ROOT") or os.path.join(REPO, "build", "test-runs"))
    ap.add_argument("--run-id", default="q00-%s-%s" % (
        datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ"), secrets.token_hex(3)))
    ap.add_argument("--seed", default="0")
    args = ap.parse_args()

    root = os.path.abspath(args.artifact_root)
    floor_dir = os.path.join(root, args.run_id + ".floor")
    try:
        os.makedirs(root, exist_ok=True)
        os.mkdir(floor_dir, 0o700)          # exclusive: a rerun never overwrites an earlier floor
    except OSError as exc:
        print("q00: cannot create %s: %s" % (floor_dir, exc), file=sys.stderr)
        return 2
    expected, required = os.path.join(floor_dir, "expected.json"), os.path.join(floor_dir, "required.json")

    if step("1/3 derive the independent floor for the %s tier (oracles.DEFECTS; test modules on disk)" % args.tier,
            [FLOOR, "emit", "--tier", args.tier, "--expected", expected, "--required", required]) != 0:
        print("Q00 ACCEPTANCE: FAIL (no floor)")
        return 1
    rc_run = step("2/3 run-suite %s tier with --floor" % args.tier,
                  [RUNNER, "run", "--tier", args.tier, "--manifest", MANIFEST, "--floor", required,
                   "--artifact-root", root, "--run-id", args.run_id, "--seed", args.seed])
    stream = os.path.join(root, args.run_id, "receipts.jsonl")
    if not os.path.exists(stream):
        print("Q00 ACCEPTANCE: FAIL (run-suite produced no receipt stream; exit %d)" % rc_run)
        return rc_run or 1
    rc_verify = step("3/3 independent re-verification with receipts.py",
                     [RECEIPTS, "verify", stream, "--expected", expected, "--require", required])
    ok = rc_run == 0 and rc_verify == 0
    print("Q00 ACCEPTANCE: %s  (run-suite exit %d, receipts verify exit %d)  artifacts: %s" % (
        "PASS" if ok else "FAIL", rc_run, rc_verify, os.path.join(root, args.run_id)))
    return 0 if ok else (rc_run or rc_verify or 1)


if __name__ == "__main__":
    sys.exit(main())
