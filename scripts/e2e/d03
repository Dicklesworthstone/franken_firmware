#!/usr/bin/env bash
# D03 end-to-end entry point (bead ffw-j9r): clock-rate estimator and drift resampler.
# Delegates to tests/d03/run_cases.py (offline, stdlib Python; it builds and boots nothing).
#
#   scripts/e2e/d03                              META checks only; every Rust-backed case is BLOCKED
#   scripts/e2e/d03 --judge LOG [LOG ...]        judge the centrally run cargo test output
#   scripts/e2e/d03 --tier smoke|full|soak --judge LOG [--receipts DIR]
#   scripts/e2e/d03 --list                       planned case ids
#   scripts/e2e/d03 --write-vectors              regenerate tests/d03/vectors.json (Python reference only)
#
# The Rust suites run only through the centralized RCH path; this script never invokes cargo:
#   RCH_REQUIRE_REMOTE=1 rch exec -- cargo test -p franken-dsp resample -- --nocapture
#   RCH_REQUIRE_REMOTE=1 rch exec -- cargo test -p franken-dsp --test d03_quality -- --nocapture   (quality bands)
#   RCH_REQUIRE_REMOTE=1 rch exec -- cargo test -p franken-clock -- --nocapture
#   RCH_REQUIRE_REMOTE=1 rch exec -- cargo test -p franken-speaker --test d03_closed_loop -- --nocapture
#   RCH_REQUIRE_REMOTE=1 rch exec -- cargo test -p franken-speaker --test d03_closed_loop -- --ignored --nocapture   (soak)
#   RCH_REQUIRE_REMOTE=1 rch exec -- cargo clippy -p franken-dsp -p franken-clock -p franken-speaker --all-targets -- -D warnings
#
# Every run writes a JSONL diagnostic log through the shared Q00 sink (next to the receipt with --receipts); a run whose log lost
# critical evidence is NOT QUALIFIED. A run that is not a pass prints how to replay it, its versions and artifact digests
# (docs/contracts/d03.md section 7.1).
#
# Exit 0 only when every case passed, none is blocked and the diagnostic log is complete; 1 on a failed case or a log that lost
# critical evidence; 3 when the only non-passes are blocked cases (reported, never counted as passed); 2 on usage errors.
# Cycles on a real core are reported as "not measured: needs hardware"; D03-TARGET-RECEIPT re-judges the committed QEMU run of
# the big-endian MIPS guest (guest instructions per frame and the target-ISA samples; toolchain/results/runs/*/d03-target-receipt.json).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
if [ "$#" -eq 0 ]; then
  set -- --tier full
fi
exec python3 -B "$ROOT/tests/d03/run_cases.py" "$@"
