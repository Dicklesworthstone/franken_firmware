#!/usr/bin/env bash
# P05 end-to-end entry point (bead ffw-ipz): the semantic 64-bit replacement in crates/franken-atomic.
# Delegates to tests/p05/run_cases.py (offline, stdlib Python). It builds nothing, touches no device and
# reads no network. With no arguments it runs the full tier.
#
#   scripts/e2e/p05                                  full tier
#   scripts/e2e/p05 --tier smoke|full                explicit tier
#   scripts/e2e/p05 --central-log FILE               judge each Rust test BY NAME from a central cargo test log
#   scripts/e2e/p05 --upstream-clone DIR             also re-run the read-only Asupersync scan (git objects only)
#   scripts/e2e/p05 --tier full --case P05-DIR-002 [--receipts DIR]     replay one case
#   scripts/e2e/p05 --list                           list the selected cases
#   scripts/e2e/p05 --workspace-suite [ARGS]         the earlier workspace suite for this bead, unchanged
#
# What this does and does not show. The Python runner re-derives the checker corpus, the directed scripts
# and the seeded sweeps with an independent model, shows each deliberately weakened rule and each planted
# wrong cell (split-word, truncating) is caught against a green baseline, and checks the documentation and
# the crate hygiene. The REPLACEMENT ITSELF is exercised by the Rust tests in crates/franken-atomic, which
# build, so they run only through the centralized RCH path:
#
#   RCH_REQUIRE_REMOTE=1 rch exec -- cargo test -p franken-atomic          # then pass the log with --central-log
#
# Each Rust test is judged by name from that log: ok passes, FAILED fails, absent is BLOCKED. Totals are
# never used. Without a log the run is NOT QUALIFIED and exits 3. Target builds, guest receipts, the
# Asupersync adaptation and the per-site audit are listed as blocked cases and counted, never passed.
#
# Exit 0 only when every case passed and none is blocked; 1 on a failed case; 3 when the only non-passes are
# blocked cases; 2 on usage or a malformed case file.
#
# `--workspace-suite` keeps the earlier behaviour of this entry point (the portable-atomic tests and the
# Asupersync cross-checks through scripts/test/run-workspace-verification.py p05) for anyone who relied on it.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
if [ "${1:-}" = "--workspace-suite" ]; then
  shift
  exec python3 "$ROOT/scripts/test/run-workspace-verification.py" p05 "$@"
fi
if [ "$#" -eq 0 ]; then
  set -- --tier full
fi
exec python3 -B "$ROOT/tests/p05/run_cases.py" "$@"
