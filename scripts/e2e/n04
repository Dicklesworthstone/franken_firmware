#!/usr/bin/env bash
# N04 end-to-end entry point (bead ffw-nx0): bounded playout with a consume_by cutoff, concealment and latency changes.
# Delegates to tests/n04/run_cases.py (offline, stdlib Python; it builds and boots nothing).
#
#   scripts/e2e/n04                              META checks only; every Rust-backed case is BLOCKED
#   scripts/e2e/n04 --judge LOG [LOG ...]        judge the centrally run cargo test output
#   scripts/e2e/n04 --tier smoke|full --judge LOG [--receipts DIR]
#   scripts/e2e/n04 --list                       planned case ids
#   scripts/e2e/n04 --write-vectors              regenerate tests/n04/vectors.json (Python reference only)
#
# The Rust suite runs only through the centralized RCH path; this script never invokes cargo:
#   RCH_REQUIRE_REMOTE=1 rch exec -- cargo test -p franken-stream -- --nocapture
#   RCH_REQUIRE_REMOTE=1 rch exec -- cargo clippy -p franken-stream --all-targets -- -D warnings
# (the module is wired into franken-stream/src/lib.rs only after the first green compile: docs/contracts/n04.md section 11)
#
# Exit 0 only when every case passed and none is blocked; 1 on a failed case; 3 when the only
# non-passes are blocked cases (reported, never counted as passed); 2 on usage errors.
# DAC / acoustic presentation, listening quality of concealment and CPU on the target ISA are reported as not measured.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
if [ "$#" -eq 0 ]; then
  set -- --tier full
fi
exec python3 -B "$ROOT/tests/n04/run_cases.py" "$@"
