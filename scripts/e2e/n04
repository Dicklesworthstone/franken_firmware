#!/usr/bin/env bash
# N04 end-to-end entry point (bead ffw-nx0): bounded playout with a consume_by cutoff, concealment and latency changes.
# Delegates to tests/n04/run_cases.py (offline, stdlib Python; it builds and boots nothing).
#
#   scripts/e2e/n04                              META checks only; every Rust-backed case is BLOCKED
#   scripts/e2e/n04 --judge LOG [LOG ...]        judge the centrally run cargo test output
#   scripts/e2e/n04 --tier smoke|full --judge LOG [--receipts DIR]
#                              Each decided case writes a critical begin/end pair into a bounded, redacted JSONL diagnostic log (next to the
#                              receipt with --receipts); a pass cannot rest on a log that lost one. --judge logs must be regular files
#                              (at most 16, 64 MiB together), read through one opened descriptor.
#   scripts/e2e/n04 --tier soak                  NOT RUN, with the reason: exit 4, never a pass (nothing is read or judged)
#   scripts/e2e/n04 --list                       planned case ids
#   scripts/e2e/n04 --write-vectors              regenerate tests/n04/vectors.json (Python reference only)
#
# The Rust suite runs only through the centralized RCH path; this script never invokes cargo. The judge needs ALL THREE binaries from one
# batch: franken-stream (engine, worlds, route hint, paired trace), franken-alloc-probe, and franken-speaker (the arrival-consumer controls of
# playout_adapter::tests, named in ARRIVAL_TESTS_BY_CASE). A case whose binary is missing from the logs stays blocked, never passed.
# --no-fail-fast keeps one failing binary from hiding the results of the others:
#   RCH_REQUIRE_REMOTE=1 rch exec -- cargo +1.99.0 test --locked --no-fail-fast -p franken-stream -p franken-alloc-probe -p franken-speaker --features franken-speaker/harness -j1 -- --nocapture
#   RCH_REQUIRE_REMOTE=1 rch exec -- cargo +1.99.0 clippy --locked -p franken-stream -p franken-alloc-probe -p franken-speaker --all-targets --features franken-speaker/harness -j1 -- -D warnings
# (the module is wired into franken-stream/src/lib.rs only after the first green compile: docs/contracts/n04.md section 11)
#
# Exit 0 only when every case passed, none is blocked and the diagnostic log is complete; 1 on a failed case or a log that lost critical
# evidence; 3 when the only non-passes are blocked cases (reported, never counted as passed); 4 for --tier soak (NOT RUN); 2 on usage
# errors and refused input (a missing, non-regular or oversized --judge log; printed redacted, never echoed raw).
# DAC / acoustic presentation, listening quality of concealment and CPU on the target ISA are reported as not measured.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
if [ "$#" -eq 0 ]; then
  set -- --tier full
fi
exec python3 -B "$ROOT/tests/n04/run_cases.py" "$@"
