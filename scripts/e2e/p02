#!/usr/bin/env bash
# P02 end-to-end entry point (bead ffw-jub): the minimal legacy platform capability layer, offline.
# Stdlib Python only, no cargo, no QEMU, no device. Contract: docs/contracts/p02.md.
#
#   scripts/e2e/p02          the host-side cross-checks (errno and open-flag numbers and syscall numbers against the E03 oracle
#                            and probes, the Rust text and, when present, the libc crate; the generated guest evidence against
#                            the committed transcripts; the platform-startup marker grammar), then prints the central cargo plan
#   scripts/e2e/p02 --plan   only print the central plan
#   scripts/e2e/p02 --tier smoke|full|soak [--judge LOG [LOG ...]] [--receipts DIR] [--list]
#                              the tiered runner (tests/p02/run_cases.py; its docstring is the description of the tiers and of what a pass is not):
#                              smoke: the clause map is whole and the Python host cross-checks pass (no log needed).
#                              full: smoke + one case per requirement id of the acceptance, each decided from named Rust tests in the retained
#                              cargo log(s) given with --judge; a missing, ignored or failed named test never passes, and without a log the
#                              Rust cases are BLOCKED. Every run writes a bounded JSONL diagnostic log through the shared Q00 sink; a lost
#                              critical event makes the run NOT QUALIFIED.
#                              soak: NOT RUN, with the reason: exit 4, never a pass.
#
# The Rust unit tests, clippy and the device-target type checks are central work (`rch exec`), not run here; the plan
# below is exactly what they are. Nothing in this entry point has run against a kernel.
#
# Exit codes: 0 the tests passed; 1 a test failed; 2 usage. The tiered runner adds 3 (only blocked cases: evidence missing, never a pass) and 4 (soak).
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
MANIFEST="$ROOT/Cargo.toml"
WORKER_ENV="${FFW_RCH_WORKERS:+RCH_WORKERS=$FFW_RCH_WORKERS}"
DEVICE_POOL="${FFW_RCH_DEVICE_WORKERS:-${FFW_RCH_WORKERS:-}}"
DEVICE_WORKER_ENV="${DEVICE_POOL:+RCH_WORKERS=$DEVICE_POOL}"
TOOLCHAIN="${FFW_RCH_TOOLCHAIN:-nightly-2026-08-31}"

plan() {
  cat <<EOF
# Central plan for P02 (run from $ROOT/crates/franken-platform so rch syncs only the crate's Cargo closure; every cargo
# step names its job count because rch ignores CARGO_BUILD_JOBS). fmt is not an rch command (RCH-E301): run locally.
rustfmt --edition 2024 --check $ROOT/crates/franken-platform/src/lib.rs
RCH_REQUIRE_REMOTE=1 ${WORKER_ENV} rch exec -- cargo test   --locked --offline --manifest-path $MANIFEST -p franken-platform --config build.incremental=false -j 2
RCH_REQUIRE_REMOTE=1 ${WORKER_ENV} rch exec -- cargo clippy --locked --offline --manifest-path $MANIFEST -p franken-platform --all-targets --config build.incremental=false -j 2 -- -D warnings
RCH_REQUIRE_REMOTE=1 ${WORKER_ENV} rch exec -- cargo clippy --locked --offline --manifest-path $MANIFEST -p franken-platform --lib --features sim --config build.incremental=false -j 2 -- -D warnings
# Device targets (type check only: nothing is linked or run). Select workers with the pinned nightly rust-src through native admission;
# FFW_RCH_WORKERS / FFW_RCH_DEVICE_WORKERS override the candidate pools, never worker capacity or strict-remote policy.
RCH_REQUIRE_REMOTE=1 ${DEVICE_WORKER_ENV} rch exec -- cargo +$TOOLCHAIN check --locked --offline --manifest-path $MANIFEST -p franken-platform --target mips-unknown-linux-musl    -Z build-std=core,alloc,std,panic_abort --config build.incremental=false -j 2
RCH_REQUIRE_REMOTE=1 ${DEVICE_WORKER_ENV} rch exec -- cargo +$TOOLCHAIN check --locked --offline --manifest-path $MANIFEST -p franken-platform --target powerpc-unknown-linux-musl -Z build-std=core,alloc,std,panic_abort --config build.incremental=false -j 2
# The Linux leaf (run from $ROOT): the only unsafe crate; clippy on both device targets compiles its asm.
rustfmt --edition 2024 --check $ROOT/crates/franken-platform-linux/src/lib.rs
RCH_REQUIRE_REMOTE=1 ${WORKER_ENV} rch exec -- cargo test   --locked --offline --manifest-path $MANIFEST -p franken-platform-linux --config build.incremental=false -j 2
RCH_REQUIRE_REMOTE=1 ${WORKER_ENV} rch exec -- cargo clippy --locked --offline --manifest-path $MANIFEST -p franken-platform-linux --all-targets --config build.incremental=false -j 2 -- -D warnings
RCH_REQUIRE_REMOTE=1 ${DEVICE_WORKER_ENV} rch exec -- cargo +$TOOLCHAIN clippy --locked --offline --manifest-path $MANIFEST -p franken-platform-linux --target mips-unknown-linux-musl    -Z build-std=core,alloc,std,panic_abort --config build.incremental=false -j 2 -- -D warnings
RCH_REQUIRE_REMOTE=1 ${DEVICE_WORKER_ENV} rch exec -- cargo +$TOOLCHAIN clippy --locked --offline --manifest-path $MANIFEST -p franken-platform-linux --target powerpc-unknown-linux-musl -Z build-std=core,alloc,std,panic_abort --config build.incremental=false -j 2 -- -D warnings
# The device speaker's startup (run from $ROOT: a crate-directory cwd syncs only that crate's cargo closure): platform_start unit tests, clippy, and both device targets (lib and bin).
# The device speaker build with the contract's linker and static flags, and the QEMU speaker smoke, are the P01 plan and the E07 runner.
rustfmt --edition 2024 --check $ROOT/crates/franken-speaker/src/lib.rs $ROOT/crates/franken-speaker/src/main.rs
RCH_REQUIRE_REMOTE=1 ${WORKER_ENV} rch exec -- cargo test   --locked --offline --manifest-path $MANIFEST -p franken-speaker --lib --config build.incremental=false -j 2 -- platform_start
RCH_REQUIRE_REMOTE=1 ${WORKER_ENV} rch exec -- cargo clippy --locked --offline --manifest-path $MANIFEST -p franken-speaker --all-targets --config build.incremental=false -j 2 -- -D warnings
RCH_REQUIRE_REMOTE=1 ${DEVICE_WORKER_ENV} rch exec -- cargo +$TOOLCHAIN clippy --locked --offline --manifest-path $MANIFEST -p franken-speaker --target mips-unknown-linux-musl    -Z build-std=core,alloc,std,panic_abort --config build.incremental=false -j 2 -- -D warnings
RCH_REQUIRE_REMOTE=1 ${DEVICE_WORKER_ENV} rch exec -- cargo +$TOOLCHAIN clippy --locked --offline --manifest-path $MANIFEST -p franken-speaker --target powerpc-unknown-linux-musl -Z build-std=core,alloc,std,panic_abort --config build.incremental=false -j 2 -- -D warnings
EOF
}

case "${1:-}" in
  --plan) plan; exit 0 ;;
  "") ;;
  --tier|--judge|--receipts|--list) exec python3 -B "$ROOT/tests/p02/run_cases.py" "$@" ;;
  *) echo "usage: scripts/e2e/p02 [--plan | --list | --tier smoke|full|soak [--judge LOG [LOG ...]] [--receipts DIR]]" >&2; exit 2 ;;
esac
python3 -B -I -m unittest discover -s "$ROOT/tests/p02" -p 'test_*.py' || { echo "scripts/e2e/p02: tests FAILED" >&2; exit 1; }
echo
plan
exit 0
