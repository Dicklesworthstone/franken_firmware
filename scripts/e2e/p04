#!/usr/bin/env bash
# P04 end-to-end entry point (bead ffw-0bh): board HAL adapters and the fake-device harness.
# Delegates to tests/p04/run_cases.py (offline, stdlib Python). It builds nothing, touches no device and
# reads no network. With no arguments it runs the full tier.
#
#   scripts/e2e/p04                          full tier
#   scripts/e2e/p04 --tier smoke|full        explicit tier
#   scripts/e2e/p04 --tier full --case P04-ABI-003 [--receipts DIR]     replay one case
#   scripts/e2e/p04 --list                   list the selected cases
#
# What this does and does not show. The Python runner checks the wire-record vectors with an independent
# codec, proves the case set catches a planted defect, and checks that every required invariant maps to
# Rust tests that exist. The BEHAVIOR (fail-muted, inert tokens, owner-held storage, quarantine, owner
# destruction, drain without false success) is exercised by the Rust tests in crates/franken-hal, which
# drive the actual HalSession against the deterministic fake device. Those build, so they run only
# through the centralized RCH path:
#
#   RCH_REQUIRE_REMOTE=1 rch exec -- cargo test -p franken-hal
#
# Exit 0 only when every case passed and no required case is blocked; 1 on a failed case; 3 when the only
# non-passes are blocked cases (reported, never counted as passed); 2 on usage or a malformed case file.
# The full tier is expected to exit 3 until central Rust verification and a separate true-device ledger
# exist, because both are counted as blocked, not skipped.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
if [ "$#" -eq 0 ]; then
  set -- --tier full
fi
exec python3 -B "$ROOT/tests/p04/run_cases.py" "$@"
