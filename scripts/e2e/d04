#!/usr/bin/env bash
# D04 end-to-end entry point (bead ffw-5h5): the protected render loop on the retained HAL.
# Delegates to tests/d04/run_cases.py (offline, stdlib Python). It builds nothing, touches no device and
# reads no network. With no arguments it runs the full tier.
#
#   scripts/e2e/d04                          full tier
#   scripts/e2e/d04 --tier smoke|full        explicit tier
#   scripts/e2e/d04 --tier full --case D04-TIM-002 [--receipts DIR]     replay one case
#   scripts/e2e/d04 --list                   list the selected cases
#
# What this does and does not show. The Python runner re-derives every scripted run with an independent
# model of the loop's timing and classification, checks the committed scenarios are exactly what that
# model says, proves the case set catches planted wrong rules, and checks that every required invariant
# maps to Rust tests that exist. The LOOP ITSELF (lifecycle, deadlines, the four causes, the cleanup
# reserve, held buffers, device loss versus process death, control storms, and the bytes that reach the
# fake device) is exercised by the Rust tests in crates/franken-speaker/src/render.rs, which drive the
# real D03 resampler, the real D02 protection and the P04 HalSession against the deterministic fake
# device. Those build, so they run only through the centralized RCH path:
#
#   RCH_REQUIRE_REMOTE=1 rch exec -- cargo test -p franken-speaker
#
# Exit 0 only when every case passed and no required case is blocked; 1 on a failed case; 3 when the only
# non-passes are blocked cases (reported, never counted as passed); 2 on usage or a malformed case file.
# The full tier is expected to exit 3 until central Rust verification, board measurements, the process-death
# qualification and the P03 runtime exist, because each is counted as blocked, not skipped.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
if [ "$#" -eq 0 ]; then
  set -- --tier full
fi
exec python3 -B "$ROOT/tests/d04/run_cases.py" "$@"
