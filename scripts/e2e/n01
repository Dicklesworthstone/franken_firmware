#!/usr/bin/env bash
# N01 end-to-end entry point (bead ffw-ey5): authenticated stream framing, offline.
#
#   scripts/e2e/n01                                  the full tier (see below); the Rust-backed cases are BLOCKED without a log
#   scripts/e2e/n01 --tier smoke|full [--judge LOG [LOG ...]] [--receipts DIR] [--list]
#                              smoke: the independent references regenerate the committed vectors and the clause map is whole.
#                              full: smoke + the unit tests of the references and judges + the committed fuzz record + one case per
#                              clause of the acceptance, each decided from named Rust tests in the centrally run `cargo test` log(s).
#                              Every run writes a bounded diagnostic log through the shared Q00 sink; a non-pass prints RETAINED FOR REPLAY.
#   scripts/e2e/n01 --tier soak                      NOT RUN, with the reason: exit 4, never a pass
#   scripts/e2e/n01 --write    regenerate crates/franken-stream/tests/vectors/n01_wire_vectors.json
#   scripts/e2e/n01 --judge-guest LOG [--endian big|little]
#                              judge the log of the `n01_wire_guest` binary (docs/contracts/n01.md section 7):
#                              every vector, planted datagram and the byte-order probe. Exit 0 only if all hold.
#   scripts/e2e/n01 --judge-fuzz seeds SEEDS_LOG
#   scripts/e2e/n01 --judge-fuzz run LOG --target T --kind clean|control --budget SECONDS [...]
#                              judge the logs of the central coverage-guided fuzz runs (docs/contracts/n01.md section 11).
#   scripts/e2e/n01 --verify-fuzz-record [DIR ...]
#                              verify the committed record of the central fuzz run without its logs (the records the
#                              contract cites, or the given directories): docs/contracts/n01.md section 11.
#
# Exit 0 only when every case passed, none is blocked and the diagnostic log is complete; 1 on a failed case or a log that lost critical
# evidence; 3 when the only non-passes are blocked cases (reported, never counted as passed); 4 for --tier soak; 2 on usage errors.
#
# THIS SCRIPT DOES NOT RUN THE RUST IMPLEMENTATION. The reference side proves the vectors are self-consistent and match the
# contract-derived reference (stdlib hmac/struct, set-based replay model). The Rust crate replays the same vectors, and exchanges real
# datagrams over loopback UDP, only under the centralized builds; its result enters here only as a log:
#   RCH_REQUIRE_REMOTE=1 rch exec -- cargo test --locked -p franken-stream -- --nocapture
# Without that log a green exit is not evidence about franken-stream, and the Rust-backed cases say so by being BLOCKED.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

if [ "${1:-}" = "--write" ]; then
  python3 -B -I "$ROOT/tests/n01/reference_frames.py" --write
  exec python3 -B -I "$ROOT/tests/n01/reference_negotiation.py" --write
fi
if [ "${1:-}" = "--judge-guest" ]; then
  shift
  if [ "$#" -lt 1 ] || [ "$#" -gt 3 ]; then
    echo "usage: scripts/e2e/n01 --judge-guest LOG [--endian big|little]" >&2
    exit 2
  fi
  exec python3 -B -I "$ROOT/tests/n01/guest_transcript.py" "$@"
fi
if [ "${1:-}" = "--judge-fuzz" ]; then
  shift
  exec python3 -B -I "$ROOT/tests/n01/fuzz_judge.py" "$@"
fi
if [ "${1:-}" = "--verify-fuzz-record" ]; then
  shift
  exec python3 -B -I "$ROOT/tests/n01/fuzz_record.py" "$@"
fi
exec python3 -B "$ROOT/tests/n01/run_cases.py" "$@"
