def _expand_token(tok: str, manifest_dir: str) -> str:
    return tok.replace("{python}", sys.executable).replace("{manifest_dir}", manifest_dir)


def _parse_case(raw: Any, suite: str, manifest: str, errors: List[str]) -> Optional[Case]:
    mdir = os.path.dirname(manifest)
    where = "%s: case" % os.path.basename(manifest)
    if not isinstance(raw, dict):
        errors.append("%s is not an object" % where)
        return None
    cid = raw.get("id")
    if not isinstance(cid, str) or not ID_RE.match(cid):
        errors.append("%s has invalid id %r (want %s)" % (where, cid, ID_RE.pattern))
        return None
    where = "%s: case %s" % (os.path.basename(manifest), cid)
    n_before = len(errors)
    unknown = sorted(set(raw) - _CASE_KEYS)
    if unknown:
        errors.append("%s has unknown keys %s" % (where, unknown))

    argv = raw.get("argv")
    if not (isinstance(argv, list) and argv and all(isinstance(a, str) and a for a in argv)):
        errors.append("%s: argv must be a non-empty list of non-empty strings" % where)
        argv = []
    argv = [_expand_token(a, mdir) for a in argv]

    cwd_raw = raw.get("cwd", ".")
    if not isinstance(cwd_raw, str):
        errors.append("%s: cwd must be a string" % where)
        cwd_raw = "."
    cwd = os.path.normpath(os.path.join(mdir, cwd_raw))

    tiers = raw.get("tiers", ["full"])
    if not (isinstance(tiers, list) and tiers and all(t in TIERS for t in tiers)):
        errors.append("%s: tiers must be a non-empty subset of %s" % (where, list(TIERS)))
        tiers = []

    reqs = raw.get("requirements", [])
    if not (isinstance(reqs, list) and all(isinstance(r, str) and ID_RE.match(r) for r in reqs)):
        errors.append("%s: requirements must be a list of requirement ids" % where)
        reqs = []

    timeout_s = raw.get("timeout_s", DEFAULT_CASE_TIMEOUT_S)
    if isinstance(timeout_s, bool) or not isinstance(timeout_s, (int, float)) or not (
        0 < timeout_s <= MAX_CASE_TIMEOUT_S
    ):
        errors.append("%s: timeout_s must be a number in (0, %d]" % (where, int(MAX_CASE_TIMEOUT_S)))
        timeout_s = DEFAULT_CASE_TIMEOUT_S

    mandatory = raw.get("mandatory", True)
    if not isinstance(mandatory, bool):
        errors.append("%s: mandatory must be a boolean" % where)
        mandatory = True

    eclass = raw.get("evidence_class", "host-simulation")
    if eclass not in EVIDENCE_CLASSES:
        errors.append("%s: evidence_class must be one of %s" % (where, list(EVIDENCE_CLASSES)))
        eclass = "host-simulation"

    env = raw.get("env", {})
    if not (isinstance(env, dict) and all(isinstance(k, str) and isinstance(v, str) for k, v in env.items())):
        errors.append("%s: env must map strings to strings" % where)
        env = {}
    for k in env:
        if not ENV_NAME_RE.match(k) or k.startswith(RESERVED_ENV_PREFIX):
            errors.append("%s: env name %r is invalid or reserved (%s*)" % (where, k, RESERVED_ENV_PREFIX))

    env_inherit = raw.get("env_inherit", [])
    if not (isinstance(env_inherit, list) and all(isinstance(k, str) and ENV_NAME_RE.match(k) for k in env_inherit)):
        errors.append("%s: env_inherit must be a list of env var names" % where)
        env_inherit = []

    expect = raw.get("expect", {"kind": "pass"})
    exp_kind, exp_oracle, exp_violation, exp_codes = "pass", None, None, [1]
    if not isinstance(expect, dict) or set(expect) - {"kind", "oracle", "violation", "exit_codes"}:
        errors.append("%s: expect must be an object with kind/oracle/violation/exit_codes" % where)
    else:
        exp_kind = expect.get("kind", "pass")
        if exp_kind not in ("pass", "fail"):
            errors.append("%s: expect.kind must be 'pass' or 'fail'" % where)
            exp_kind = "pass"
        if exp_kind == "fail":
            # A canary names the exact defect it plants: which oracle must fire AND which violation
            # kind it must report.  An oracle that merely failed, or never finished, proves nothing.
            exp_oracle = expect.get("oracle")
            if not (isinstance(exp_oracle, str) and exp_oracle):
                errors.append("%s: a known-defect canary must name expect.oracle" % where)
                exp_oracle = None
            exp_violation = expect.get("violation")
            if not (isinstance(exp_violation, str) and exp_violation):
                errors.append("%s: a known-defect canary must name expect.violation (the violation kind)" % where)
                exp_violation = None
            exp_codes = expect.get("exit_codes", [1])
            if not (isinstance(exp_codes, list) and exp_codes and all(
                isinstance(c, int) and not isinstance(c, bool) and 0 <= c <= 255 for c in exp_codes
            )):
                errors.append("%s: expect.exit_codes must be a non-empty list of 0..255" % where)
                exp_codes = [1]
        elif "oracle" in expect or "violation" in expect or "exit_codes" in expect:
            errors.append("%s: expect.oracle/violation/exit_codes only apply to kind 'fail'" % where)

    req_stdout = raw.get("required_stdout", [])
    if not (isinstance(req_stdout, list) and all(isinstance(p, str) for p in req_stdout)):
        errors.append("%s: required_stdout must be a list of regexes" % where)
        req_stdout = []
    for pat in req_stdout:
        try:
            re.compile(pat)
        except re.error as exc:
            errors.append("%s: bad required_stdout regex %r: %s" % (where, pat, exc))

    requires = raw.get("requires", {})
    r_exe: List[str] = []
    r_env: List[str] = []
    r_files: List[str] = []
    if not isinstance(requires, dict) or set(requires) - {"executables", "env", "files"}:
        errors.append("%s: requires must be an object with executables/env/files" % where)
    else:
        r_exe = requires.get("executables", [])
        r_env = requires.get("env", [])
        r_files = requires.get("files", [])
        for label, val in (("executables", r_exe), ("env", r_env), ("files", r_files)):
            if not (isinstance(val, list) and all(isinstance(v, str) and v for v in val)):
                errors.append("%s: requires.%s must be a list of strings" % (where, label))
                if label == "executables":
                    r_exe = []
                elif label == "env":
                    r_env = []
                else:
                    r_files = []
        r_files = [os.path.normpath(os.path.join(mdir, f)) for f in r_files]

    arts = raw.get("artifacts", [])
    if not (isinstance(arts, list) and all(isinstance(a, str) and a for a in arts)):
        errors.append("%s: artifacts must be a list of relative paths" % where)
        arts = []
    arts = [os.path.normpath(os.path.join(mdir, a)) for a in arts]

    blocked = raw.get("blocked")
    if blocked is not None and not (isinstance(blocked, str) and blocked):
        errors.append("%s: blocked must be a non-empty reason string" % where)
        blocked = None

    cap = raw.get("max_output_bytes", DEFAULT_OUTPUT_CAP)
    if isinstance(cap, bool) or not isinstance(cap, int) or not 1024 <= cap <= HARD_OUTPUT_CAP:
        errors.append("%s: max_output_bytes must be an integer in [1024, %d]" % (where, HARD_OUTPUT_CAP))
        cap = DEFAULT_OUTPUT_CAP

    desc = raw.get("description", "")
    if not isinstance(desc, str):
        errors.append("%s: description must be a string" % where)
        desc = ""

    if len(errors) > n_before:
        return None
    return Case(
        id=cid, suite=suite, manifest=manifest, argv=argv, cwd=cwd, tiers=list(tiers),
        requirements=list(reqs), timeout_s=float(timeout_s), mandatory=mandatory,
        evidence_class=eclass, env=dict(env), env_inherit=list(env_inherit),
        expect_kind=exp_kind, expect_oracle=exp_oracle, expect_violation=exp_violation,
        expect_exit_codes=list(exp_codes),
        required_stdout=list(req_stdout), requires_exe=list(r_exe),
        requires_env=list(r_env), requires_files=list(r_files), artifacts=list(arts),
        blocked_reason=blocked, max_output_bytes=cap, description=desc,
    )


def discover_manifests(files: Sequence[str], dirs: Sequence[str]) -> List[str]:
    found: Dict[str, None] = {}
    for f in files:
        p = os.path.realpath(f)
        if not os.path.isfile(p):
            raise UsageError("manifest not found: %s" % f)
        found[p] = None
    for d in dirs:
        root = os.path.realpath(d)
        if not os.path.isdir(root):
            raise UsageError("manifest dir not found: %s" % d)
        hits = 0
        for cur, subdirs, names in os.walk(root):
            subdirs.sort()
            for name in sorted(names):
                if name.endswith(".suite.json"):
                    found[os.path.join(cur, name)] = None
                    hits += 1
        if hits == 0:
            raise UsageError("no *.suite.json under %s (an empty registry must not pass silently)" % d)
    if not found:
        raise UsageError("no manifests given; use --manifest or --manifest-dir")
    return sorted(found)


def load_registry(files: Sequence[str], dirs: Sequence[str]) -> Registry:
    errors: List[str] = []
    cases: List[Case] = []
    reqs: Dict[str, Requirement] = {}
    required_all: List[str] = []
    required_by_tier: Dict[str, List[str]] = {t: [] for t in TIERS}
    manifests: List[Dict[str, str]] = []
    seen_ids: Dict[str, str] = {}

    for path in discover_manifests(files, dirs):
        try:
            size = os.stat(path).st_size
            if size > MAX_MANIFEST_BYTES:
                errors.append("%s: manifest larger than %d bytes" % (path, MAX_MANIFEST_BYTES))
                continue
            with open(path, "rb") as fh:
                blob = fh.read()
            doc = json.loads(blob.decode("utf-8"))
        except (OSError, ValueError) as exc:
            errors.append("%s: cannot load manifest: %s" % (path, exc))
            continue
        if not isinstance(doc, dict) or doc.get("schema") != SUITE_SCHEMA:
            errors.append("%s: schema must be %r" % (path, SUITE_SCHEMA))
            continue
        extra = sorted(set(doc) - _TOP_KEYS)
        if extra:
            errors.append("%s: unknown top-level keys %s" % (path, extra))
        suite = doc.get("suite")
        if not (isinstance(suite, str) and ID_RE.match(suite)):
            errors.append("%s: suite must be an id string" % path)
            suite = "unnamed"
        manifests.append({"path": path, "suite": suite, "sha256": sha256_bytes(blob)})

        raw_reqs = doc.get("requirements", {})
        if not isinstance(raw_reqs, dict):
            errors.append("%s: requirements must be an object" % path)
            raw_reqs = {}
        for rid, rv in raw_reqs.items():
            if not ID_RE.match(rid):
                errors.append("%s: invalid requirement id %r" % (path, rid))
                continue
            if isinstance(rv, str):
                text, rtiers = rv, list(TIERS)
            elif isinstance(rv, dict) and set(rv) <= {"text", "tiers"} and isinstance(rv.get("text"), str):
                text, rtiers = rv["text"], rv.get("tiers", list(TIERS))
                if not (isinstance(rtiers, list) and rtiers and all(t in TIERS for t in rtiers)):
                    errors.append("%s: requirement %s has bad tiers" % (path, rid))
                    continue
            else:
                errors.append("%s: requirement %s must be a string or {text, tiers}" % (path, rid))
                continue
            prev = reqs.get(rid)
            if prev and (prev.text != text or prev.tiers != rtiers):
                errors.append("%s: requirement %s conflicts with an earlier definition" % (path, rid))
            reqs[rid] = Requirement(rid, text, list(rtiers))

        rc = doc.get("required_cases", [])
        if isinstance(rc, list) and all(isinstance(x, str) and ID_RE.match(x) for x in rc):
            required_all.extend(rc)
        elif isinstance(rc, dict) and all(
            k in TIERS and isinstance(v, list) and all(isinstance(x, str) and ID_RE.match(x) for x in v)
            for k, v in rc.items()
        ):
            for k, v in rc.items():
                required_by_tier[k].extend(v)
        else:
            errors.append("%s: required_cases must be a list of ids or {tier: [ids]}" % path)

        raw_cases = doc.get("cases", [])
        if not isinstance(raw_cases, list):
            errors.append("%s: cases must be a list" % path)
            raw_cases = []
        for raw in raw_cases:
            case = _parse_case(raw, suite, path, errors)
            if case is None:
                continue
            if case.id in seen_ids:
                errors.append(
                    "duplicate case id %s (in %s and %s); ids are stable and global"
                    % (case.id, seen_ids[case.id], path)
                )
                continue
            seen_ids[case.id] = path
            cases.append(case)

    known = set(reqs)
    for case in cases:
        for rid in case.requirements:
            if rid not in known:
                errors.append(
                    "case %s references undefined requirement %s (load the manifest that defines it)"
                    % (case.id, rid)
                )
    if errors:
        shown = errors[:20]
        more = "" if len(errors) <= 20 else "\n  ... and %d more" % (len(errors) - 20)
        raise UsageError("manifest errors:\n  " + "\n  ".join(shown) + more)
    return Registry(cases, reqs, required_all, required_by_tier, manifests)


# --------------------------------------------------------------------------- #
# selection and seeds
# --------------------------------------------------------------------------- #

@dataclasses.dataclass
class Planned:
    case: Optional[Case]               # None for a synthetic (missing mandatory) entry
    synthetic_id: Optional[str] = None
    synthetic_reason: Optional[str] = None
    synthetic_detail: str = ""


def select_cases(registry: Registry, tier: str, only: Sequence[str]) -> Tuple[List[Planned], int, bool]:
    """Return (planned entries, deselected count, partial_selection)."""
    by_id = {c.id: c for c in registry.cases}
    partial = bool(only)
    if partial:
        planned_cases: List[Case] = []
        for cid in only:
            if cid not in by_id:
                raise UsageError("--case %s is not defined in the loaded manifests" % cid)
            if tier not in by_id[cid].tiers:
                raise UsageError("--case %s is not in tier %s (tiers: %s)" % (cid, tier, by_id[cid].tiers))
            if by_id[cid] not in planned_cases:
                planned_cases.append(by_id[cid])
        deselected = len(registry.cases) - len(planned_cases)
        return [Planned(c) for c in planned_cases], deselected, True

    selected = [c for c in registry.cases if tier in c.tiers]
    entries = [Planned(c) for c in selected]
    required = list(dict.fromkeys(registry.required_all + registry.required_by_tier.get(tier, [])))
    chosen = {c.id for c in selected}
    for rid in required:
        if rid in chosen:
            continue
        if rid in by_id:
            entries.append(Planned(None, rid, "required_case_not_in_tier",
                                   "defined with tiers %s but required in tier %s" % (by_id[rid].tiers, tier)))
        else:
            entries.append(Planned(None, rid, "missing_mandatory_case", "required but defined in no loaded manifest"))
    return entries, len(registry.cases) - len(selected), False


# --------------------------------------------------------------------------- #
# event sink (bounded, exposes loss, never blocks)
# --------------------------------------------------------------------------- #

def make_event_sink(diag: Any, run_dir: str, run_id: str, t0_ns: int, planned: int,
                    event_log_bytes: Optional[int], literals: Sequence[str]) -> Any:
    """The run's event log: the shared bounded, nonblocking, redacting, closure-checked ``DiagnosticSink``.

    Kept as a module-level factory so tests can substitute a sink over an injected-fault target.  The critical
    reserve scales with the plan (one critical ``case_end`` per case plus run bookkeeping), so critical events
    are bounded by construction and never compete with non-critical ones for the same bytes."""
    reserve = max(64 * 1024, (planned + 16) * 2048)
    max_file = event_log_bytes if event_log_bytes is not None else reserve + 8 * 1024 * 1024
    try:
        limits = diag.SinkLimits(max_file_bytes=max_file, critical_reserve_bytes=reserve)
    except ValueError as exc:
        raise UsageError("--event-log-bytes %d cannot hold the critical events of %d planned cases "
                         "(need at least %d): %s" % (max_file, planned, reserve + 16 * 1024, exc))
    policy = diag.RedactionPolicy(literals=tuple(l for l in literals if len(l) >= 4), scrub_home=False)
    try:
        return diag.DiagnosticSink.to_file(
            os.path.join(run_dir, "events.jsonl"), run_id=run_id, limits=limits, redaction=policy,
            clock_ns=lambda: time.monotonic_ns() - t0_ns)
    except OSError as exc:
        raise UsageError("cannot create the event log in %s: %s" % (run_dir, exc))


# --------------------------------------------------------------------------- #
# bounded output capture (never blocks the child)
# --------------------------------------------------------------------------- #

class Capture(threading.Thread):
    def __init__(self, fd: int, log_path: str, cap_bytes: int, redactor: Redactor,
                 markers: Sequence[str]) -> None:
        super().__init__(daemon=True)
        self.fd = fd
        self.log_path = log_path
        self.cap = cap_bytes
        self.redactor = redactor
        self.markers = [re.compile(m) for m in markers]
        self.marker_hit = [False] * len(self.markers)
        self.stop_event = threading.Event()
        self.bytes_seen = 0
        self.bytes_kept = 0
        self.bytes_dropped = 0
        self.lines = 0
        self.lines_dropped = 0
        self.overlong_lines = 0
        self.binary_lines = 0
        self.truncated = False
        self.write_error: Optional[str] = None
        self.annotation_error: Optional[str] = None
        self.events = 0            # lines that reached the log file (incl. runner annotations)
        self.dropped_events = 0    # lines that were counted but not stored (cap / write failure)
        self.eof = False
        self.tail: "collections.deque[str]" = collections.deque(maxlen=MAX_TAIL_LINES)
        self._log: Optional[int] = None

    def annotate(self, text: str) -> int:
        """Append a runner-authored line after the capture thread has finished.

        It bypasses the output cap (it is the classification evidence).  Returns the
        line's sequence index, which is what ``first_causal_event.log_seq`` points at;
        the index counts dropped lines too, so it stays valid when the log was capped."""
        seq = self.events + self.dropped_events
        data = (text.replace("\n", " ").replace("\r", " ") + "\n").encode("utf-8", "replace")
        try:
            fd = os.open(self.log_path, os.O_WRONLY | os.O_APPEND)
        except OSError as exc:
            self.annotation_error = "open:" + errno.errorcode.get(exc.errno or 0, str(exc.errno))
            self.dropped_events += 1
            return seq
        try:
            if os.write(fd, data) == len(data):
                self.events += 1
                self.bytes_kept += len(data)
            else:
                self.annotation_error = "short_write"
                self.dropped_events += 1
        except OSError as exc:
            self.annotation_error = errno.errorcode.get(exc.errno or 0, str(exc.errno))
            self.dropped_events += 1
        finally:
            os.close(fd)
        return seq

    @property
    def lost(self) -> bool:
        """True when evidence for this attempt could not be stored (receipts: critical_lost)."""
        return self.write_error is not None or self.annotation_error is not None

    def _open_log(self) -> None:
        try:
            self._log = os.open(self.log_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except OSError as exc:
            self.write_error = "open:" + errno.errorcode.get(exc.errno or 0, str(exc.errno))

    def _write(self, data: bytes) -> bool:
        if self._log is None or self.write_error:
            return False
        try:
            if os.write(self._log, data) != len(data):
                self.write_error = "short_write"
                return False
            return True
        except OSError as exc:
            self.write_error = errno.errorcode.get(exc.errno or 0, str(exc.errno))
            return False

    def _line(self, raw: bytes, overlong: bool = False) -> None:
        self.lines += 1
        text = raw.decode("utf-8", "replace")
        printable = sum(1 for ch in text if ch.isprintable() or ch in "\t\r")
        binary = b"\x00" in raw or (len(text) > 0 and printable / len(text) < 0.7)
        if not binary:
            for i, pat in enumerate(self.markers):
                if not self.marker_hit[i] and pat.search(text):
                    self.marker_hit[i] = True
            out = self.redactor.redact_line(text)
        else:
            self.binary_lines += 1
            out = "[binary payload %d bytes redacted]" % len(raw)
        if overlong:
            self.overlong_lines += 1
            out += " [line truncated]"
        self.tail.append(out[:400])
        data = (out + "\n").encode("utf-8", "replace")
        if self.bytes_kept + len(data) > self.cap:
            if not self.truncated:
                self.truncated = True
                marker = b"[run-suite: output log truncated at cap; later output dropped and counted]\n"
                if self._write(marker):
                    self.events += 1
            self.bytes_dropped += len(data)
            self.lines_dropped += 1
            self.dropped_events += 1
            return
        if self._write(data):
            self.bytes_kept += len(data)
            self.events += 1
        else:
            self.bytes_dropped += len(data)
            self.lines_dropped += 1
            self.dropped_events += 1

    def run(self) -> None:
        self._open_log()
        buf = b""
        skipping = False
        try:
            while True:
                ready, _, _ = select.select([self.fd], [], [], 0.1)
                if not ready:
                    if self.stop_event.is_set():
                        break
                    continue
                try:
                    chunk = os.read(self.fd, 65536)
                except InterruptedError:
                    continue
                except OSError:
                    break
                if not chunk:
                    self.eof = True
                    break
                self.bytes_seen += len(chunk)
                if skipping:
                    nl = chunk.find(b"\n")
                    if nl < 0:
                        self.bytes_dropped += len(chunk)
                        continue
                    self.bytes_dropped += nl + 1
                    chunk = chunk[nl + 1:]
                    skipping = False
                buf += chunk
                while True:
                    nl = buf.find(b"\n")
                    if nl < 0:
                        break
                    line, buf = buf[:nl], buf[nl + 1:]
                    if len(line) > MAX_LINE_BYTES:
                        self.bytes_dropped += len(line) - MAX_LINE_BYTES
                        line = line[:MAX_LINE_BYTES]
                        self._line(line, overlong=True)
                    else:
                        self._line(line)
                if len(buf) > MAX_LINE_BYTES:
                    self._line(buf[:MAX_LINE_BYTES], overlong=True)
                    self.bytes_dropped += len(buf) - MAX_LINE_BYTES
                    buf = b""
                    skipping = True
            if buf:
                self._line(buf)  # unterminated final line (child died mid-write)
        finally:
            if self._log is not None:
                try:
                    os.close(self._log)
                except OSError:
                    pass

    def stats(self) -> Dict[str, Any]:
        return {
            "path": self.log_path,
            "bytes_seen": self.bytes_seen,
            "bytes_kept": self.bytes_kept,
            "bytes_dropped": self.bytes_dropped,
            "lines": self.lines,
            "lines_dropped": self.lines_dropped,
            "overlong_lines": self.overlong_lines,
            "binary_lines": self.binary_lines,
            "truncated": self.truncated or self.overlong_lines > 0,
            "write_error": self.write_error,
            "annotation_error": self.annotation_error,
            "events": self.events,
            "dropped_events": self.dropped_events,
            "cap_bytes": self.cap,
        }


# --------------------------------------------------------------------------- #
# process-group control
# --------------------------------------------------------------------------- #

def kill_group(pgid: int, sig: int) -> None:
    try:
        os.killpg(pgid, sig)
    except (ProcessLookupError, PermissionError):
        pass


def group_alive(pgid: int) -> bool:
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def wait_group_gone(pgid: int, seconds: float) -> bool:
    end = time.monotonic() + seconds
    while True:
        if not group_alive(pgid):
            return True
        if time.monotonic() >= end:
            return False
        time.sleep(0.02)


def terminate_tree(proc: "subprocess.Popen[bytes]", pgid: int, grace_s: float,
                   hard: threading.Event) -> bool:
    """SIGTERM -> grace -> SIGKILL on the whole group.  True if the group is gone."""
    kill_group(pgid, signal.SIGTERM)
    deadline = time.monotonic() + grace_s
    while True:
        proc.poll()
        if proc.returncode is not None and not group_alive(pgid):
            return True
        if hard.is_set() or time.monotonic() >= deadline:
            break
        time.sleep(0.02)
    kill_group(pgid, signal.SIGKILL)
    try:
        proc.wait(timeout=2)
    except subprocess.TimeoutExpired:
        pass
    return wait_group_gone(pgid, 2.0) and proc.poll() is not None


# --------------------------------------------------------------------------- #
# child result receipt
# --------------------------------------------------------------------------- #

def _canon(value: Any) -> str:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), default=str)


def _bound_json(value: Any, redactor: Redactor) -> Any:
    """Redact a child-supplied JSON value and keep it small; stays JSON."""
    value = clip_obj(redactor.redact_obj(value), 1024)
    if len(_canon(value)) > 4096:
        return clip(_canon(value), 4096)
    return value


def read_case_result(path: str, run_id: str, case_id: str, nonce: str, redactor: Redactor,
                     oracle_kinds: Sequence[str]) -> Tuple[Optional[Dict[str, Any]], Optional[str]]:
    """Return (sanitised result, error reason).  Exactly one is None.

    Self-contradictory receipts are rejected here (``result_invalid``) rather than
    interpreted: a pass must have zero mismatches, a fail at least one, and a fail
    must say what it expected and observed (and the two must differ)."""
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except FileNotFoundError:
        return None, "result_missing"
    except OSError:
        return None, "result_invalid"
    try:
        blob = os.read(fd, MAX_RESULT_BYTES + 1)
    except OSError:
        return None, "result_invalid"
    finally:
        os.close(fd)
    if len(blob) > MAX_RESULT_BYTES:
        return None, "result_oversize"
    try:
        doc = json.loads(blob.decode("utf-8"))
    except ValueError:
        return None, "result_invalid"
    if not isinstance(doc, dict) or doc.get("schema") != RESULT_SCHEMA:
        return None, "result_invalid"
    if doc.get("run_id") != run_id or doc.get("case_id") != case_id or doc.get("nonce") != nonce:
        return None, "result_stale"
    verdict = doc.get("verdict")
    if verdict not in ("pass", "fail", "incomplete"):
        return None, "result_invalid"
    oracle = doc.get("oracle")
    if not (isinstance(oracle, str) and oracle and len(oracle) <= 128):
        return None, "result_invalid"
    if doc.get("oracle_kind") not in oracle_kinds:
        return None, "result_invalid"
    if not isinstance(doc.get("independent"), bool) or not isinstance(doc.get("finalized"), bool):
        return None, "result_invalid"
    checks, mismatches = doc.get("checks"), doc.get("mismatches")
    for n in (checks, mismatches):
        if isinstance(n, bool) or not isinstance(n, int) or n < 0:
            return None, "result_invalid"
    reasons = doc.get("incomplete_reasons")
    if not (isinstance(reasons, list) and len(reasons) <= 16
            and all(isinstance(x, str) and x for x in reasons)):
        return None, "result_invalid"
    kinds = doc.get("violation_kinds")
    if not (isinstance(kinds, dict) and len(kinds) <= 32 and all(
            isinstance(k, str) and k and isinstance(v, int) and not isinstance(v, bool) and v >= 1
            for k, v in kinds.items())):
        return None, "result_invalid"
    # The receipt invariant: mismatches are exactly the sum of the typed violation counts.
    if sum(kinds.values()) != mismatches:
        return None, "result_invalid"
    if verdict == "pass" and (mismatches != 0 or kinds):
        return None, "result_invalid"
    if verdict == "fail" and (mismatches < 1 or not kinds):
        return None, "result_invalid"
    # An "incomplete" verdict must say why; it never carries manufactured mismatches.
    if verdict == "incomplete" and not (reasons or doc["finalized"] is False):
        return None, "result_invalid"
    if verdict == "incomplete" and mismatches != 0:
        return None, "result_invalid"

    expected = _bound_json(doc.get("expected"), redactor)
    observed = _bound_json(doc.get("observed"), redactor)
    if verdict == "fail":
        if doc.get("expected") is None or doc.get("observed") is None or _canon(expected) == _canon(observed):
            return None, "result_invalid"  # a failure must say what differed

    event = doc.get("first_causal_event")
    if event is not None and not isinstance(event, str):
        event = _canon(event)
    counters = doc.get("counters", {})
    if not (isinstance(counters, dict) and all(isinstance(k, str) and isinstance(v, int)
                                               and not isinstance(v, bool) for k, v in counters.items())):
        counters = {}
    return {
        "verdict": verdict,
        "oracle": redactor.redact_text(oracle),
        "oracle_kind": doc["oracle_kind"],
        "independent": doc["independent"],
        "finalized": doc["finalized"],
        "incomplete_reasons": [clip(redactor.redact_text(x), 200) for x in reasons],
        "violation_kinds": {clip(redactor.redact_text(k), 128): v for k, v in sorted(kinds.items())},
        "checks": checks,
        "mismatches": mismatches,
        "expected": expected,
        "observed": observed,
        "first_causal_event": clip(redactor.redact_text(event), 2048) if event else None,
        "counters": dict(list(counters.items())[:64]),
    }, None


# --------------------------------------------------------------------------- #
# classification (pure; unit-testable)
# --------------------------------------------------------------------------- #

@dataclasses.dataclass
class Facts:
    rc: Optional[int]
    kill_reason: Optional[str]        # timeout | global_timeout | cancelled
    signal_name: Optional[str]
    leaked: bool
    result: Optional[Dict[str, Any]]
    result_error: Optional[str]
    markers_missing: List[str]


def _oracle_unfinished(r: Dict[str, Any]) -> bool:
    """True when the oracle did not finish its job, whatever else it reports (receipts.py agrees)."""
    return r["verdict"] == "incomplete" or r["finalized"] is False or bool(r["incomplete_reasons"])


def classify(case: Case, f: Facts) -> Tuple[str, str, str]:
    """Return (status, reason, detail).  Only 'pass' or 'fail' occur here.

    Evidence that is missing or unfinished is never converted into a defect: an
    incomplete oracle gets its own reason and can satisfy neither an ordinary case
    nor an expected-failure canary, even if it carries the expected oracle name."""
    canary = case.expect_kind == "fail"
    if f.kill_reason:
        if canary:
            return "fail", "canary_wrong_failure_mode", f.kill_reason
        return "fail", f.kill_reason, ""
    if f.signal_name:
        if canary:
            return "fail", "canary_wrong_failure_mode", "crashed:" + f.signal_name
        return "fail", "crashed", f.signal_name

    if canary:
        if f.result_error:
            return "fail", "canary_no_result", f.result_error
        assert f.result is not None
        r = f.result
        if _oracle_unfinished(r):
            return "fail", "canary_oracle_incomplete", "oracle %s: %s" % (
                r["oracle"], ",".join(r["incomplete_reasons"]) or "not finalized")
        if r["verdict"] == "pass":
            return "fail", "canary_not_detected", "subject passed; planted defect went undetected"
        if r["oracle"] != case.expect_oracle:
            return "fail", "canary_wrong_oracle", "fired %r, expected %r" % (r["oracle"], case.expect_oracle)
        if case.expect_violation not in r["violation_kinds"]:
            return "fail", "canary_wrong_violation", "violation kinds %s, expected %r" % (
                sorted(r["violation_kinds"]), case.expect_violation)
        if f.rc not in case.expect_exit_codes:
            return "fail", "canary_unexpected_exit", "exit %s not in %s" % (f.rc, case.expect_exit_codes)
        if not r["independent"]:
            return "fail", "oracle_not_independent", "the detecting oracle declares independent=false"
        if r["checks"] < 1:
            return "fail", "vacuous_pass", "the detecting oracle reports zero checks"
        if f.leaked:
            return "fail", "leaked_process", "background process survived the case"
        return "pass", "canary_detected", "%s/%s" % (case.expect_oracle, case.expect_violation)

    if f.result and _oracle_unfinished(f.result):
        # Typed and distinct, whatever the exit code says (an incomplete oracle usually exits non-zero).
        return "fail", "oracle_incomplete", "oracle %s: %s" % (
            f.result["oracle"], ",".join(f.result["incomplete_reasons"]) or "not finalized")
    if f.rc != 0:
        if f.result and f.result["verdict"] == "fail":
            return "fail", "oracle_failed", f.result["oracle"] or ""
        return "fail", "nonzero_exit", str(f.rc)
    if f.result_error:
        return "fail", f.result_error, ""
    assert f.result is not None
    r = f.result
    if r["verdict"] != "pass":
        return "fail", "oracle_failed", "exit 0 but receipt verdict is fail (%s)" % (r["oracle"],)
    if not r["independent"]:
        return "fail", "oracle_not_independent", "oracle %s declares independent=false" % (r["oracle"],)
    if r["checks"] < 1:
        return "fail", "vacuous_pass", "receipt reports zero checks"
    if f.markers_missing:
        return "fail", "required_marker_missing", "; ".join(f.markers_missing)
    if f.leaked:
        return "fail", "leaked_process", "background process survived the case"
    return "pass", "ok", ""


# --------------------------------------------------------------------------- #
# run context + case execution
# --------------------------------------------------------------------------- #

@dataclasses.dataclass
class RunContext:
    run_id: str
    run_dir: str
    tier: str
    run_seed: int
    redactor_literals: List[str]
    events: Any
    cancel: threading.Event
    hard_cancel: threading.Event
    stop: threading.Event                 # fail-fast
    global_deadline: float
    kill_grace_s: float
    retries: int
    case_timeout_cap_s: float
    output_cap: int
    env_allow: List[str]
    replay_prefix: List[str]
    rx: Any = None                        # the loaded test_support/receipts.py module
    t0_ns: int = 0                        # monotonic origin shared by events and receipts
    # Artifact identities are fixed once, at plan time, before any child can create or change a file.
    artifact_refs: Dict[str, List[Dict[str, Any]]] = dataclasses.field(default_factory=dict)
    cancel_signal: List[str] = dataclasses.field(default_factory=list)
    fail_fast: bool = False

    def stop_if_fail_fast(self) -> None:
        if self.fail_fast:
            self.stop.set()


def precheck(case: Case, ctx: RunContext) -> Optional[Tuple[str, str]]:
    """Return (reason, detail) if the case cannot be attempted -> status blocked."""
    if case.evidence_class in EXTERNAL_CLASSES:
        return "external_evidence_required", (
            "evidence class %s needs a separately authorised external receipt; never run or claimed here"
            % case.evidence_class)
    if case.blocked_reason:
        return "declared_blocked", case.blocked_reason
    if not os.path.isdir(case.cwd):
        return "missing_cwd", os.path.basename(case.cwd)
    exe = case.argv[0]
    if os.sep in exe:
        path = exe if os.path.isabs(exe) else os.path.join(case.cwd, exe)
        if not (os.path.isfile(path) and os.access(path, os.X_OK)):
            return "missing_executable", exe
    elif shutil.which(exe) is None:
        return "missing_executable", exe
    for name in case.requires_exe:
        if shutil.which(name) is None:
            return "missing_prerequisite", "executable " + name
    for name in case.requires_env:
        if name not in os.environ:
            return "missing_prerequisite", "env " + name
    for path in case.requires_files + case.artifacts:
        if not os.path.exists(path):
            return "missing_prerequisite", "file " + os.path.basename(path)
    return None


def build_env(case: Case, ctx: RunContext, attempt: int, seed: int, scratch: str,
              result_path: str, nonce: str) -> Dict[str, str]:
    env: Dict[str, str] = {}
    for name in list(DEFAULT_ENV_INHERIT) + list(ctx.env_allow) + list(case.env_inherit):
        if name in os.environ:
            env[name] = os.environ[name]
    if "HOME" not in case.env_inherit:
        env["HOME"] = os.path.join(scratch, "home")
    env["TMPDIR"] = os.path.join(scratch, "tmp")
    env["PYTHONHASHSEED"] = str(seed % (2**32 - 1))
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    env["PYTHONUTF8"] = "1"
    env.update(case.env)
    env.update({
        "FFW_SUITE_PROTOCOL": "1",
        "FFW_RUN_ID": ctx.run_id,
        "FFW_CASE_ID": case.id,
        "FFW_ATTEMPT": str(attempt),
        "FFW_SEED": str(seed),
        "FFW_RUN_SEED": str(ctx.run_seed),
        "FFW_CASE_DIR": scratch,
        "FFW_RESULT_PATH": result_path,
        "FFW_RESULT_NONCE": nonce,
        "FFW_TIMEOUT_S": repr(min(case.timeout_s, ctx.case_timeout_cap_s)),
        "FFW_NETWORK": "loopback-only",
    })
    return env


def artifact_identities(case: Case) -> List[Dict[str, Any]]:
    seen: Dict[str, None] = {}
    candidates = list(case.artifacts)
    for tok in case.argv:
        path = tok if os.path.isabs(tok) else os.path.join(case.cwd, tok)
        if os.path.isfile(path):
            candidates.append(os.path.normpath(path))
    if shutil.which(case.argv[0]):
        candidates.append(shutil.which(case.argv[0]) or "")
    out = []
    for path in candidates:
        if not path or path in seen:
            continue
        seen[path] = None
        out.append({"path": path, "sha256": sha256_file(path)})
    return out


def run_attempt(ctx: RunContext, case: Case, attempt: int, seed: int) -> Dict[str, Any]:
    corr = "%s/%s/%d" % (ctx.run_id, case.id, attempt)
    redactor = Redactor(ctx.redactor_literals)
    scratch = os.path.join(ctx.run_dir, "scratch", case.id, "a%d" % attempt)
    os.makedirs(os.path.join(scratch, "tmp"))
    os.makedirs(os.path.join(scratch, "home"))
    result_path = os.path.join(scratch, "result.json")
    log_path = os.path.join(ctx.run_dir, "logs", "%s.a%d.log" % (case.id, attempt))
    nonce = secrets.token_hex(16)
    timeout_s = min(case.timeout_s, ctx.case_timeout_cap_s)
    cap = min(case.max_output_bytes, ctx.output_cap)
    rec: Dict[str, Any] = {"attempt": attempt, "seed": seed, "timeout_s": timeout_s, "corr": corr}
    env = build_env(case, ctx, attempt, seed, scratch, result_path, nonce)
    ctx.events.emit_event("case_start", case_id=case.id, attempt=attempt, corr=corr, seed=seed, timeout_s=timeout_s)

    t_start = time.monotonic()
    rec["started_mono_ns"] = time.monotonic_ns() - ctx.t0_ns
    try:
        proc = subprocess.Popen(
            case.argv, cwd=case.cwd, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT, start_new_session=True, close_fds=True,
        )
    except OSError as exc:
        rec.update(status="blocked", reason="spawn_failed",
                   detail=errno.errorcode.get(exc.errno or 0, "OSError"), executed=False)
        _cleanup_scratch(ctx, scratch, rec)
        return rec

    rec["executed"] = True
    pgid = proc.pid
    assert proc.stdout is not None
    capture = Capture(proc.stdout.fileno(), log_path, cap, redactor, case.required_stdout)
    capture.start()

    kill_reason: Optional[str] = None
    while True:
        try:
            proc.wait(timeout=POLL_S)
            break
        except subprocess.TimeoutExpired:
            pass
        now = time.monotonic()
        if ctx.cancel.is_set():
            kill_reason = "cancelled"
        elif now >= ctx.global_deadline:
            kill_reason = "global_timeout"
        elif now - t_start >= timeout_s:
            kill_reason = "timeout"
        if kill_reason:
            break

    group_clear = True
    leaked = False
    if kill_reason:
        group_clear = terminate_tree(proc, pgid, ctx.kill_grace_s, ctx.hard_cancel)
    elif not wait_group_gone(pgid, 0.25):
        leaked = True
        kill_group(pgid, signal.SIGKILL)
        group_clear = wait_group_gone(pgid, 2.0)

    capture.join(3.0)
    abandoned = False
    if capture.is_alive():
        capture.stop_event.set()
        capture.join(1.0)
        abandoned = capture.is_alive()
    try:
        proc.stdout.close()
    except OSError:
        pass
    duration_ms = int((time.monotonic() - t_start) * 1000)
    rec["ended_mono_ns"] = time.monotonic_ns() - ctx.t0_ns

    rc = proc.returncode
    sig_name = signal_name(-rc) if (rc is not None and rc < 0 and not kill_reason) else None
    result, rerr = read_case_result(result_path, ctx.run_id, case.id, nonce, redactor, ctx.rx.ORACLE_KINDS)
    missing = [pat for pat, hit in zip(case.required_stdout, capture.marker_hit) if not hit]
    facts = Facts(rc, kill_reason, sig_name, leaked, result, rerr, missing)
    status, reason, detail = classify(case, facts)
    detail = redactor.redact_text(detail)

    # The runner's own classification goes into the case log as an annotation line, so a
    # silent child still has an indexable log and first_causal_event.log_seq has a target.
    from_child = result is not None and reason in (
        "oracle_failed", "oracle_not_independent", "vacuous_pass", "canary_detected", "canary_not_detected",
        "canary_wrong_oracle", "canary_wrong_violation", "canary_unexpected_exit", "oracle_incomplete",
        "canary_oracle_incomplete")
    cause_kind = "child.oracle" if from_child else "runner." + reason
    note = "[run-suite] attempt=%d status=%s reason=%s rc=%s signal=%s kill=%s%s" % (
        attempt, status, reason, rc, sig_name, kill_reason,
        (" oracle=%s mismatches=%s first_causal_event=%s" % (
            result["oracle"], result["mismatches"], result["first_causal_event"])) if result else "")
    log_seq = capture.annotate(redactor.redact_text(note))
    log_bytes = os.path.getsize(log_path) if os.path.exists(log_path) else 0
    log_sha = sha256_file(log_path, cached=False) if os.path.exists(log_path) else None
    rec.update(
        status=status, reason=reason, detail=detail, rc=rc,
        signal=sig_name, kill_reason=kill_reason, duration_ms=duration_ms, leaked=leaked,
        group_clear=group_clear, capture_abandoned=abandoned, log=capture.stats(),
        result=result, result_error=rerr, markers_missing=missing, cause_kind=cause_kind, log_seq=log_seq,
        receipt_log={
            "sha256": log_sha or sha256_bytes(b""), "events": capture.events, "dropped": capture.dropped_events,
            "bytes": log_bytes, "truncated": bool(capture.truncated or capture.overlong_lines > 0),
            "critical_lost": bool(capture.lost or abandoned or log_sha is None),
        },
    )
    if status != "pass":
        rec["tail"] = list(capture.tail)
    _cleanup_scratch(ctx, scratch, rec)
    ctx.events.emit_event("case_attempt_end", case_id=case.id, attempt=attempt, corr=corr, status=status,
                    reason=reason, duration_ms=duration_ms, log_bytes_seen=capture.bytes_seen,
                    log_bytes_dropped=capture.bytes_dropped)
    return rec


def _cleanup_scratch(ctx: RunContext, scratch: str, rec: Dict[str, Any]) -> None:
    root = os.path.realpath(os.path.join(ctx.run_dir, "scratch"))
    target = os.path.realpath(scratch)
    if os.path.commonpath([root, target]) != root or target == root:
        rec["cleanup_error"] = "refused: scratch path escaped the run directory"
        return
    try:
        shutil.rmtree(target)
    except OSError as exc:
        rec["cleanup_error"] = errno.errorcode.get(exc.errno or 0, "OSError")
    # prune the per-case parent if now empty (best effort, own directory only)
    try:
        os.rmdir(os.path.dirname(target))
    except OSError:
        pass


def replay_command(ctx: RunContext, case_id: str, run_seed: int) -> str:
    return " ".join(shlex.quote(p) for p in ctx.replay_prefix + ["--case", case_id, "--seed", str(run_seed)])


def process_entry(ctx: RunContext, entry: Planned) -> Dict[str, Any]:
    if entry.case is None:
        rec = {
            "id": entry.synthetic_id, "status": "not_run", "reason": entry.synthetic_reason,
            "detail": entry.synthetic_detail, "executed": False, "mandatory": True,
            "evidence_class": None, "requirements": [], "attempts": [], "synthetic": True,
        }
        ctx.events.emit_event("case_not_run", critical=True, case_id=entry.synthetic_id, reason=entry.synthetic_reason)
        return rec

    case = entry.case
    seed = ctx.rx.derive_case_seed(ctx.run_seed, case.id)
    base: Dict[str, Any] = {
        "id": case.id, "suite": case.suite, "mandatory": case.mandatory,
        "evidence_class": case.evidence_class, "requirements": list(case.requirements),
        "expect": {"kind": case.expect_kind, "oracle": case.expect_oracle,
                   "exit_codes": case.expect_exit_codes if case.expect_kind == "fail" else None},
        "seed": seed, "replay": replay_command(ctx, case.id, ctx.run_seed),
        "artifacts": ctx.artifact_refs.get(case.id, []), "attempts": [], "executed": False, "flaky": False,
        "original_failure": None, "causal_chain": [],
    }

    def finish(status: str, reason: str, detail: str = "", critical_event: str = "case_end") -> Dict[str, Any]:
        base.update(status=status, reason=reason, detail=detail)
        ctx.events.emit_event(critical_event, critical=True, case_id=case.id, corr="%s/%s" % (ctx.run_id, case.id),
                        status=status, reason=reason, attempts=len(base["attempts"]),
                        replay=base["replay"])
        return base

    blocked = precheck(case, ctx)
    if blocked:
        return finish("blocked", blocked[0], blocked[1], "case_blocked")
    if ctx.cancel.is_set():
        return finish("not_run", "cancelled", "run cancelled before this case started")
    if ctx.stop.is_set():
        return finish("not_run", "fail_fast", "an earlier case failed under --fail-fast")
    if time.monotonic() >= ctx.global_deadline:
        return finish("not_run", "global_timeout", "global deadline passed before this case started")

    first_failure: Optional[Dict[str, Any]] = None
    for attempt in range(1, ctx.retries + 2):
        if attempt > 1 and (ctx.cancel.is_set() or time.monotonic() >= ctx.global_deadline):
            break
        rec = run_attempt(ctx, case, attempt, seed)
        base["attempts"].append(rec)
        if rec.get("executed"):
            base["executed"] = True
        if rec["status"] == "blocked":
            if first_failure is None:
                return finish("blocked", rec["reason"], rec.get("detail", ""), "case_blocked")
            break  # a retry that cannot even start never hides the original failure
        if rec["status"] == "pass":
            if first_failure is not None:
                base["flaky"] = True
                base["original_failure"] = {k: first_failure.get(k) for k in
                                            ("attempt", "reason", "detail", "rc", "signal", "result")}
                return _finish_fail(ctx, case, base, first_failure, flaky=True, finish=finish)
            return finish("pass", rec["reason"], rec.get("detail", ""))
        if first_failure is None:
            first_failure = rec
        if rec["reason"] in ("cancelled", "global_timeout"):
            break
        if attempt <= ctx.retries:   # only announce a retry that will really happen
            ctx.events.emit_event("case_retry", case_id=case.id, attempt=attempt, reason=rec["reason"])
    assert first_failure is not None
    base["original_failure"] = {k: first_failure.get(k) for k in
                                ("attempt", "reason", "detail", "rc", "signal", "result")}
    return _finish_fail(ctx, case, base, first_failure, flaky=False, finish=finish)


def _finish_fail(ctx: RunContext, case: Case, base: Dict[str, Any], first: Dict[str, Any],
                 flaky: bool, finish: Any) -> Dict[str, Any]:
    chain = [{"layer": "runner", "reason": first["reason"], "detail": first.get("detail", ""),
              "rc": first.get("rc"), "signal": first.get("signal")}]
    res = first.get("result")
    if res:
        chain.append({"layer": "child", "oracle": res.get("oracle"), "expected": res.get("expected"),
                      "observed": res.get("observed"), "first_causal_event": res.get("first_causal_event")})
    base["causal_chain"] = chain
    ctx.stop_if_fail_fast()
    reason = ("flaky_pass_after_failure:" + first["reason"]) if flaky else first["reason"]
    return finish("fail", reason, first.get("detail", ""))


