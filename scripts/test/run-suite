def render_summary(receipt: Dict[str, Any], receipt_path: Optional[str], receipt_sha: Optional[str]) -> str:
    d = receipt["denominators"]
    run = receipt["run"]
    ev = receipt["evidence"]
    lines = [
        "run-suite %s  run=%s  tier=%s  seed=%s%s" % (
            receipt["runner"]["version"], run["id"], run["tier"], run["seed"],
            "  PARTIAL-SELECTION" if run["partial_selection"] else ""),
        "VERDICT: %s" % receipt["verdict"].upper(),
        "denominators: planned=%d executed=%d pass=%d fail=%d blocked=%d not_run=%d (deselected=%d, not counted)" % (
            d["planned"], d["executed"], d["pass"], d["fail"], d["blocked"], d["not_run"], d["deselected"]),
    ]
    for cls, c in sorted(receipt["by_evidence_class"].items()):
        lines.append("  class %-20s planned=%d pass=%d fail=%d blocked=%d not_run=%d" % (
            cls, c["planned"], c["pass"], c["fail"], c["blocked"], c["not_run"]))
    if receipt["uncovered_requirements"]:
        lines.append("uncovered requirements: " + ", ".join(receipt["uncovered_requirements"]))
    for b in receipt["blocking"]:
        if not b.startswith(("fail:", "not_run:", "blocked:", "uncovered_requirement:")):
            lines.append("blocking: " + b)
    bad = [c for c in receipt["cases"] if c["status"] != "pass"]
    for c in bad[:50]:
        lines.append("  %-8s %s  [%s]%s" % (c["status"].upper(), c["id"], c["reason"],
                                            ("  " + c["detail"]) if c.get("detail") else ""))
        if c.get("replay") and c["status"] == "fail":
            lines.append("           replay: " + c["replay"])
        chain = c.get("causal_chain") or []
        for link in chain[1:2]:
            lines.append("           expected=%s observed=%s first_causal_event=%s" % (
                link.get("expected"), link.get("observed"), link.get("first_causal_event")))
    if len(bad) > 50:
        lines.append("  ... %d more non-pass cases in the receipt" % (len(bad) - 50))
    agg = receipt["receipts"]["aggregator"]
    if agg is not None:
        lines.append("receipts.py aggregator: %s complete=%s verdicts: %s" % (
            "QUALIFIED" if agg["qualified"] else "NOT QUALIFIED", "yes" if agg["complete"] else "NO",
            " ".join("%s=%d" % (k, v) for k, v in agg["counts"].items() if v)))
        if agg["unqualified_reasons"]:
            lines.append("  reasons: " + ", ".join(agg["unqualified_reasons"]))
    else:
        lines.append("receipts.py aggregator: not run (no cases were planned)")
    ev_stats = ev["events"]
    st = ev_stats["stats"]
    lines.append("events: emitted=%d written=%d dropped=%d critical_lost=%d log_complete=%s" % (
        st["emitted"], st["written"], st["dropped_total"], st["critical_lost"],
        "yes" if ev_stats["verdict"]["complete"] else "NO"))
    if not ev["complete"]:
        lines.append("EVIDENCE INCOMPLETE: " + ", ".join(ev["incomplete_reasons"]))
    if receipt_path:
        lines.append("receipt: %s  sha256=%s" % (receipt_path, receipt_sha))
    return "\n".join(lines) + "\n"


