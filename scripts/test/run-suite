def denominators(records: List[Dict[str, Any]], deselected: int) -> Dict[str, int]:
    c = collections.Counter(r["status"] for r in records)
    d = {
        "planned": len(records),
        "executed": c["pass"] + c["fail"],
        "pass": c["pass"],
        "fail": c["fail"],
        "blocked": c["blocked"],
        "not_run": c["not_run"],
        "deselected": deselected,
    }
    return d


def check_invariants(records: List[Dict[str, Any]], d: Dict[str, int]) -> None:
    if d["planned"] != d["pass"] + d["fail"] + d["blocked"] + d["not_run"]:
        raise InternalError("denominator invariant broken: planned != pass+fail+blocked+not_run")
    if d["executed"] != d["pass"] + d["fail"]:
        raise InternalError("denominator invariant broken: executed != pass+fail")
    for r in records:
        if r["status"] not in ("pass", "fail", "blocked", "not_run"):
            raise InternalError("case %s has unknown status %r" % (r["id"], r["status"]))
        if r["status"] in ("pass", "fail") and not r.get("executed"):
            raise InternalError("case %s is %s but never executed" % (r["id"], r["status"]))
        if r["status"] in ("blocked", "not_run") and r.get("executed") and not r.get("attempts"):
            raise InternalError("case %s is %s yet claims execution" % (r["id"], r["status"]))


def compute_verdict(records: List[Dict[str, Any]], d: Dict[str, int], uncovered: List[str],
                    cancelled: bool, incomplete: List[str]) -> Tuple[str, List[str]]:
    blocking: List[str] = []
    if cancelled:
        return "cancelled", ["run cancelled"]
    if incomplete:
        return "incomplete", ["evidence incomplete: " + ", ".join(incomplete)]
    if d["planned"] == 0:
        blocking.append("empty_selection: no cases planned; an empty run is never a pass")
    elif d["executed"] == 0:
        # Planned work of which nothing ran (all blocked / not run, e.g. every case optional and blocked) proved
        # nothing.  The runner says so itself rather than relying on the aggregator to refuse it.
        blocking.append("nothing_executed: %d planned case(s), none launched" % d["planned"])
    for r in records:
        if r["status"] == "fail":
            blocking.append("fail:%s:%s" % (r["id"], r["reason"]))
        elif r["status"] == "not_run":
            blocking.append("not_run:%s:%s" % (r["id"], r["reason"]))
        elif r["status"] == "blocked" and r.get("mandatory", True):
            blocking.append("blocked:%s:%s" % (r["id"], r["reason"]))
    for rid in uncovered:
        blocking.append("uncovered_requirement:" + rid)
    return ("fail" if blocking else "pass"), blocking


def git_info(root: str) -> Dict[str, Any]:
    if not os.path.exists(os.path.join(root, ".git")):
        return {"head": None, "dirty_tracked_files": None, "note": "not a git checkout"}
    env = dict(os.environ, GIT_OPTIONAL_LOCKS="0")
    out: Dict[str, Any] = {"head": None, "dirty_tracked_files": None}
    try:
        head = subprocess.run(["git", "-C", root, "rev-parse", "HEAD"], capture_output=True, text=True,
                              timeout=5, env=env, stdin=subprocess.DEVNULL)
        if head.returncode == 0:
            out["head"] = head.stdout.strip()
        st = subprocess.run(["git", "-C", root, "status", "--porcelain=v1", "--untracked-files=no"],
                            capture_output=True, text=True, timeout=5, env=env, stdin=subprocess.DEVNULL)
        if st.returncode == 0:
            out["dirty_tracked_files"] = len([l for l in st.stdout.splitlines() if l.strip()])
    except (OSError, subprocess.SubprocessError):
        out["note"] = "git unavailable"
    return out


