def load_receipts() -> Tuple[Any, str]:
    """Load the helper-owned ``test_support/receipts.py`` by explicit path.

    Fail closed: the runner's qualification claim is the aggregator's, so a
    checkout without it must not silently run on a weaker private validator."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "test_support", "receipts.py")
    if not os.path.isfile(path):
        raise UsageError("test_support/receipts.py is missing next to run-suite; the receipt stream and its "
                         "independent aggregator are required (Q00 foundation cannot qualify without them)")
    sys.dont_write_bytecode = True  # never drop __pycache__ into a helper-owned directory
    spec = importlib.util.spec_from_file_location("ffw_receipts", path)
    if spec is None or spec.loader is None:
        raise UsageError("cannot load %s" % path)
    mod = importlib.util.module_from_spec(spec)
    sys.modules["ffw_receipts"] = mod
    try:
        spec.loader.exec_module(mod)
    except Exception as exc:  # a broken helper must be loud, not a degraded run
        raise UsageError("test_support/receipts.py failed to import: %r" % (exc,))
    missing = [n for n in _RECEIPTS_NEEDED if not hasattr(mod, n)]
    if missing:
        raise UsageError("test_support/receipts.py lacks required API: %s" % ", ".join(missing))
    digest = sha256_file(path, cached=False)
    if digest is None:
        raise UsageError("cannot digest %s" % path)
    return mod, digest


_DIAG: Any = None
_DIAG_NEEDED = ("DiagnosticSink", "SinkLimits", "RedactionPolicy", "redact_text", "audit_log")


def load_diagnostics() -> Tuple[Any, str]:
    """Load the helper-owned ``test_support/diagnostics.py`` by explicit path (fail closed, like receipts)."""
    global _DIAG
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "test_support", "diagnostics.py")
    if not os.path.isfile(path):
        raise UsageError("test_support/diagnostics.py is missing next to run-suite; the bounded diagnostic sink and "
                         "the shared redaction patterns are required")
    digest = sha256_file(path, cached=False)
    if digest is None:
        raise UsageError("cannot digest %s" % path)
    if _DIAG is not None and getattr(_DIAG, "_ffw_sha256", None) == digest:
        return _DIAG, digest   # one module object per file content, so every user (and every test) sees the same one
    sys.dont_write_bytecode = True
    spec = importlib.util.spec_from_file_location("ffw_diagnostics", path)
    if spec is None or spec.loader is None:
        raise UsageError("cannot load %s" % path)
    mod = importlib.util.module_from_spec(spec)
    sys.modules["ffw_diagnostics"] = mod
    try:
        spec.loader.exec_module(mod)
    except Exception as exc:
        raise UsageError("test_support/diagnostics.py failed to import: %r" % (exc,))
    missing = [n for n in _DIAG_NEEDED if not hasattr(mod, n)]
    if missing:
        raise UsageError("test_support/diagnostics.py lacks required API: %s" % ", ".join(missing))
    mod._ffw_sha256 = digest
    _DIAG = mod
    return mod, digest


def diagnostics_module() -> Any:
    return _DIAG if _DIAG is not None else load_diagnostics()[0]


def signal_name(num: int) -> str:
    try:
        return signal.Signals(num).name
    except ValueError:
        return "SIG%d" % num


def clip(text: str, limit: int) -> str:
    if len(text) <= limit:
        return text
    return text[:limit] + "...[clipped %d chars]" % (len(text) - limit)


def clip_obj(obj: Any, max_str: int) -> Any:
    if isinstance(obj, str):
        return clip(obj, max_str)
    if isinstance(obj, dict):
        return {str(k): clip_obj(v, max_str) for k, v in obj.items()}
    if isinstance(obj, (list, tuple)):
        return [clip_obj(v, max_str) for v in obj]
    return obj


# --------------------------------------------------------------------------- #
# redaction (applied to child output *before* it is written, and to every
# string that enters events / receipts / summaries)
# --------------------------------------------------------------------------- #

_PEM_BEGIN = re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----")
_PEM_END = re.compile(r"-----END [A-Z0-9 ]*PRIVATE KEY-----")
_PEM_BLOCK = re.compile(
    r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----.*?(?:-----END [A-Z0-9 ]*PRIVATE KEY-----|\Z)",
    re.DOTALL,
)


class Redactor:
    """Streaming line redactor.

    The patterns are the shared sink's (``diagnostics.redact_text``): one definition of what a secret looks
    like for events, receipts and child output alike.  This class adds only what a *stream* needs and a string
    function cannot: PEM private-key state across lines, and the "home directory only in child output" switch.
    """

    def __init__(self, literals: Sequence[str] = (), scrub_home: bool = True) -> None:
        diag = diagnostics_module()
        lits = tuple(sorted({l for l in literals if len(l) >= 4}, key=len, reverse=True))
        self._policy = diag.RedactionPolicy(literals=lits, scrub_home=scrub_home)
        self._redact = diag.redact_text
        self._in_pem = False
        self.redactions = 0

    def _scrub(self, text: str) -> str:
        out = self._redact(text, self._policy)
        if out != text:
            self.redactions += 1
        return out

    def redact_line(self, line: str) -> str:
        if self._in_pem:
            if _PEM_END.search(line):
                self._in_pem = False
            self.redactions += 1
            return "[REDACTED-PRIVATE-KEY]"
        if _PEM_BEGIN.search(line):
            self.redactions += 1
            if not _PEM_END.search(line):
                self._in_pem = True
            return "[REDACTED-PRIVATE-KEY]"
        return self._scrub(line)

    def redact_text(self, text: str) -> str:
        text = _PEM_BLOCK.sub("[REDACTED-PRIVATE-KEY]", text)
        return "\n".join(self._scrub(l) for l in text.split("\n"))

    def redact_obj(self, obj: Any) -> Any:
        if isinstance(obj, str):
            return self.redact_text(obj)
        if isinstance(obj, dict):
            return {str(k): self.redact_obj(v) for k, v in obj.items()}
        if isinstance(obj, (list, tuple)):
            return [self.redact_obj(v) for v in obj]
        return obj


