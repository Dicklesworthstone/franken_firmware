def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=RUNNER_NAME,
        description="Bounded deterministic subprocess suite runner (ffw-2qz / Q00). Offline only.")
    sub = p.add_subparsers(dest="command", required=True)

    def common(sp: argparse.ArgumentParser, tier_required: bool) -> None:
        sp.add_argument("--manifest", action="append", default=[], metavar="FILE",
                        help="a *.suite.json manifest (repeatable)")
        sp.add_argument("--manifest-dir", action="append", default=[], metavar="DIR",
                        help="recursively load every *.suite.json under DIR (repeatable)")
        sp.add_argument("--tier", choices=TIERS, required=tier_required,
                        help="explicit tier selection; there is no default")
        sp.add_argument("--case", action="append", default=[], metavar="ID",
                        help="select specific case ids (partial selection; skips registry coverage checks)")

    run = sub.add_parser("run", help="execute the selected cases")
    common(run, True)
    run.add_argument("--artifact-root", metavar="DIR", help="default: <repo>/build/test-runs or $FFW_ARTIFACT_ROOT")
    run.add_argument("--run-id", metavar="ID", help="default: UTC timestamp-pid-random; an existing id is refused")
    run.add_argument("--seed", default="0", metavar="N|random",
                     help="run seed (default 0, so runs are reproducible; 'random' picks and records one)")
    run.add_argument("--jobs", type=int, default=1, help="parallel cases (default 1)")
    run.add_argument("--global-timeout-s", type=float, default=DEFAULT_GLOBAL_TIMEOUT_S)
    run.add_argument("--case-timeout-cap-s", type=float, default=MAX_CASE_TIMEOUT_S,
                     help="clamp every case timeout to at most this many seconds")
    run.add_argument("--kill-grace-s", type=float, default=2.0, help="SIGTERM->SIGKILL grace (default 2)")
    run.add_argument("--retries", type=int, default=0,
                     help="bounded retries (0..5); a pass after a failure is still reported as a failure (flaky)")
    run.add_argument("--fail-fast", action="store_true", help="remaining unstarted cases become not_run after a failure")
    run.add_argument("--event-log-bytes", type=int, default=None, metavar="N",
                     help="total size bound of events.jsonl (default: critical reserve + 8 MiB). Non-critical events "
                          "beyond it are dropped and counted; critical events have their own reserved slice")
    run.add_argument("--event-close-timeout-s", type=float, default=DEFAULT_EVENT_CLOSE_TIMEOUT_S, metavar="S",
                     help="bound on draining and closing the event log (a hung target leaves it incomplete)")
    run.add_argument("--max-output-bytes", type=int, default=DEFAULT_OUTPUT_CAP,
                     help="per-attempt captured-output cap (case value is clamped to this)")
    run.add_argument("--env-allow", action="append", default=[], metavar="NAME",
                     help="inherit this env var into every child (names only; default is a tiny allow-list)")
    run.add_argument("--redact-env", action="append", default=[], metavar="NAME",
                     help="redact the *value* of this env var wherever it appears (value never on the command line)")
    run.add_argument("--floor", metavar="FILE",
                     help="independent required-case floor (JSON {case_id: {proof_class,canary,oracle,violation}}) "
                          "from a source the manifests cannot edit; a dropped, demoted or altered case fails the run")
    run.add_argument("--quiet", action="store_true", help="do not print the human summary")
    run.set_defaults(func=cmd_run)

    lst = sub.add_parser("list", help="print the planned case ids for a tier")
    common(lst, True)
    lst.add_argument("--json", action="store_true")
    lst.set_defaults(func=cmd_list)

    cov = sub.add_parser("coverage", help="print the requirement-to-case registry; exit 1 if any requirement is uncovered")
    common(cov, False)
    cov.set_defaults(func=cmd_coverage)
    return p


def main(argv: Optional[Sequence[str]] = None) -> int:
    try:
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    except (ValueError, OSError):
        pass
    if hasattr(signal, "SIGXFSZ"):
        try:
            signal.signal(signal.SIGXFSZ, signal.SIG_IGN)  # a full disk must surface as an OSError, not kill us
        except ValueError:
            pass  # not the main thread
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except UsageError as exc:
        sys.stderr.write("run-suite: error: %s\n" % exc)
        return EXIT_USAGE
    except InternalError as exc:
        sys.stderr.write("run-suite: INTERNAL ERROR: %s\n" % exc)
        return EXIT_INTERNAL
    except BrokenPipeError:
        return EXIT_INCOMPLETE
    except Exception as exc:  # never convert an unexpected crash into a pass
        sys.stderr.write("run-suite: INTERNAL ERROR: %r\n" % (exc,))
        return EXIT_INTERNAL


if __name__ == "__main__":
    sys.exit(main())
