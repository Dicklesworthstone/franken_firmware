def utc_now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


_digest_cache: Dict[str, Optional[str]] = {}
_digest_lock = threading.Lock()


def sha256_file(path: str, limit: int = MAX_DIGEST_FILE_BYTES, cached: bool = True) -> Optional[str]:
    """Digest of a regular file, or None if unreadable / not a file / too big.

    ``cached=False`` is for files that are still changing (logs, events)."""
    if cached:
        with _digest_lock:
            if path in _digest_cache:
                return _digest_cache[path]
    digest: Optional[str] = None
    try:
        st = os.stat(path)
        if os.path.isfile(path) and st.st_size <= limit:
            h = hashlib.sha256()
            with open(path, "rb") as fh:
                for chunk in iter(lambda: fh.read(1 << 20), b""):
                    h.update(chunk)
            digest = h.hexdigest()
    except OSError:
        digest = None
    if cached:
        with _digest_lock:
            _digest_cache[path] = digest
    return digest


_RECEIPTS_NEEDED = ("StreamWriter", "aggregate_path", "derive_case_seed", "ORACLE_KINDS",
