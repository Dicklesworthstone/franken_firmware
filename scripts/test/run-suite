def artifact_name(path: str) -> str:
    real = os.path.realpath(path)
    root = repo_root()
    name = os.path.relpath(real, root) if (real == root or real.startswith(root + os.sep)) else real
    if len(name) > 250:
        name = "ext/%s/%s" % (sha256_bytes(real.encode())[:16], os.path.basename(real)[:200])
    return name


def case_artifact_refs(case: Case) -> List[Dict[str, Any]]:
    """Digests of what this case runs: script, resolved executable, defining manifest."""
    idents = artifact_identities(case) + [{"path": case.manifest, "sha256": sha256_file(case.manifest)}]
    refs: List[Dict[str, Any]] = []
    seen = set()
    for ident in idents:
        if not ident["sha256"]:
            continue
        name = artifact_name(ident["path"])
        if name in seen:
            continue
        seen.add(name)
        refs.append({"name": name, "sha256": ident["sha256"], "size": os.path.getsize(ident["path"])})
    return refs


def build_expected(entries: Sequence[Planned]) -> Dict[str, Dict[str, Any]]:
    """The registry slice the aggregator judges against (built from the manifests, not from results)."""
    exp: Dict[str, Dict[str, Any]] = {}
    for e in entries:
        if e.case is not None:
            spec: Dict[str, Any] = {"mandatory": e.case.mandatory, "proof_class": e.case.evidence_class,
                                    "canary": e.case.expect_kind == "fail"}
            if spec["canary"]:  # the exact planted defect: which oracle, which violation kind
                spec["oracle"], spec["violation"] = e.case.expect_oracle, e.case.expect_violation
            exp[e.case.id] = spec
        else:  # required but absent from this tier / every manifest: mandatory, no record is ever written
            exp[e.synthetic_id or "?"] = {"mandatory": True, "proof_class": "host-simulation", "canary": False}
    return exp


def attempt_outcome(rec: Dict[str, Any]) -> str:
    """Map a runner attempt onto receipts.py's outcome vocabulary."""
    if rec["status"] in ("pass", "blocked", "not_run"):
        return rec["status"]
    kill = rec.get("kill_reason")
    if kill in ("timeout", "global_timeout"):
        return "timeout"
    if kill == "cancelled":
        return "cancelled"
    if rec.get("signal"):
        return "crash"
    return "fail"


def _lost(rec: Dict[str, Any]) -> bool:
    log = rec.get("receipt_log") or {}
    return bool(log.get("truncated") or log.get("critical_lost"))


def describe_failure(case: Case, rec: Dict[str, Any]) -> Tuple[str, Any, Any]:
    """(oracle, expected, observed) for a failure record; expected != observed by construction."""
    reason, res, rc = rec["reason"], rec.get("result"), rec.get("rc")
    if reason == "oracle_failed" and res and res["verdict"] == "fail":
        return res["oracle"], res["expected"], res["observed"]
    ms = rec.get("duration_ms")
    if reason == "timeout":
        return "runner.timeout", {"terminates_within_s": rec.get("timeout_s")}, {"killed_after_ms": ms}
    if reason == "global_timeout":
        return "runner.global_timeout", {"completes_before_global_deadline": True}, {"killed_after_ms": ms}
    if reason == "crashed":
        return "runner.crash", {"terminated_by_signal": None}, {"terminated_by_signal": rec.get("signal")}
    if reason == "nonzero_exit":
        return "runner.exit_status", {"exit_code": 0}, {"exit_code": rc}
    if reason == "leaked_process":
        return "runner.process_leak", {"live_processes_after_exit": 0}, {"live_processes_after_exit": ">=1"}
    if reason == "required_marker_missing":
        return "runner.stdout_markers", {"required": list(case.required_stdout)}, {"missing": rec.get("markers_missing")}
    if reason == "vacuous_pass":
        return "runner.vacuous_oracle", {"checks_at_least": 1}, {"checks": res["checks"] if res else None}
    if reason == "oracle_not_independent":
        return "runner.oracle_independence", {"independent": True}, {"independent": False}
    if reason == "oracle_failed":
        return "runner.oracle_verdict", {"verdict": "pass"}, {"verdict": "fail", "exit_code": rc}
    if reason == "oracle_incomplete":
        return ("%s.incomplete" % (res["oracle"] if res else "unknown"), {"oracle_status": "passed"},
                {"oracle_status": "incomplete", "reasons": res["incomplete_reasons"] if res else None})
    if reason == "canary_oracle_incomplete":
        return ("runner.canary", {"oracle_finishes": case.expect_oracle},
                {"oracle": res["oracle"] if res else None, "incomplete": res["incomplete_reasons"] if res else None})
    if reason == "canary_wrong_violation":
        return ("runner.canary", {"violation_kind": case.expect_violation},
                {"violation_kinds": sorted(res["violation_kinds"]) if res else None})
    if reason == "canary_not_detected":
        return "runner.canary", {"oracle_fires": case.expect_oracle}, {"verdict": "pass"}
    if reason == "canary_wrong_oracle":
        return "runner.canary", {"oracle": case.expect_oracle}, {"oracle": res["oracle"] if res else None}
    if reason == "canary_unexpected_exit":
        return "runner.canary", {"exit_code_in": list(case.expect_exit_codes)}, {"exit_code": rc}
    if reason == "canary_no_result":
        return "runner.canary", {"result_receipt": "valid, verdict fail"}, {"result_receipt": rec.get("result_error")}
    if reason == "canary_wrong_failure_mode":
        return "runner.canary", {"subject_fails_through": case.expect_oracle}, {"failure_mode": rec.get("detail")}
    if reason.startswith("result_"):
        return "runner.result_receipt", {"result_receipt": "valid ffw.case-result.v1"}, {"result_receipt": reason}
    return "runner." + reason, {"outcome": "pass"}, {"outcome": reason}


def case_stream_records(ctx: RunContext, case: Case, base: Dict[str, Any]) -> List[Dict[str, Any]]:
    """write_case(**kw) payloads for one finished case: one per attempt, or one for a never-launched case."""
    # A never-launched external-class case is an explicit, typed `blocked` record (origin local, no
    # `external`): the absence of an authorization is the reason it is blocked.  It is never omitted
    # and never laundered into `not_run`.
    seed = base["seed"]
    argv = ctx.replay_prefix + ["--case", case.id, "--seed", str(ctx.run_seed)]
    common: Dict[str, Any] = {
        "case_id": case.id, "proof_class": case.evidence_class, "canary": case.expect_kind == "fail",
        "origin": "local", "seed": seed,
        "replay": {"argv": argv, "case_id": case.id, "run_seed": ctx.run_seed, "case_seed": seed},
    }
    if not base["attempts"]:
        reason = clip("%s: %s" % (base["reason"], base.get("detail", "")), 1900)
        return [dict(common, attempt=1, outcome=base["status"], reason=reason)]
    refs = [{"name": a["name"], "sha256": a["sha256"]} for a in ctx.artifact_refs[case.id]]
    out: List[Dict[str, Any]] = []
    for rec in base["attempts"]:
        outcome = attempt_outcome(rec)
        row = dict(common, attempt=rec["attempt"], outcome=outcome)
        if outcome in ("blocked", "not_run"):
            row["reason"] = clip("%s: %s" % (rec["reason"], rec.get("detail", "")), 1900)
            out.append(row)
            continue
        row.update(
            process={"exit_code": rec.get("rc"), "timed_out": rec.get("kill_reason") in ("timeout", "global_timeout")},
            started_mono_ns=rec["started_mono_ns"], ended_mono_ns=rec["ended_mono_ns"],
            log=rec["receipt_log"], artifacts=refs)
        if outcome == "pass":
            res = rec["result"]
            # classify() only lets an independent, finalized, complete oracle through, so these are facts.
            row["oracle"] = {"name": res["oracle"], "kind": res["oracle_kind"], "independent": True,
                             "checks": res["checks"], "mismatches": res["mismatches"],
                             "status": "failed" if case.expect_kind == "fail" else "passed",
                             "finalized": True, "incomplete_reasons": [],
                             "violation_kinds": dict(res["violation_kinds"])}
        elif outcome == "cancelled":
            row["reason"] = clip("run cancelled (%s) while this case was running" % (
                ",".join(ctx.cancel_signal[:1]) or "signal"), 1900)
        else:
            oracle, expected, observed = describe_failure(case, rec)
            row["failure"] = {"oracle": oracle, "expected": expected, "observed": observed,
                              "first_causal_event": {"log_seq": rec["log_seq"], "kind": rec["cause_kind"]}}
        out.append(row)
    return out


def predicted_verdict(base: Dict[str, Any]) -> str:
    """What receipts.py's aggregator must say about this case, if the runner emitted correctly."""
    attempts = base.get("attempts", [])
    if base.get("synthetic"):
        return "not_run"  # required but defined nowhere: no record exists, the aggregator reports no_receipt
    if not attempts:
        return base["status"]
    outcomes = [attempt_outcome(a) for a in attempts]
    if any(o == "pass" and _lost(a) for o, a in zip(outcomes, attempts)):
        return "invalid"  # a pass cannot rest on a truncated or lossy log
    return next((o for o in outcomes if o != "pass"), "pass")


class Stream:
    """Thin guard around receipts.StreamWriter: I/O failure => poisoned stream => INCOMPLETE, never a crash."""

    def __init__(self, rx: Any, path: str) -> None:
        self.rx = rx
        self.path = path
        self.error: Optional[str] = None
        self.fp: Any = None
        self.writer: Any = None
        self.records = 0
        try:
            self.fp = open(path, "xb")
            self.writer = rx.StreamWriter(self.fp)
        except OSError as exc:
            self.error = "open:" + errno.errorcode.get(exc.errno or 0, str(exc.errno))

    def _guard(self, fn: Any, *a: Any, **kw: Any) -> None:
        if self.writer is None or self.error:
            return
        try:
            fn(*a, **kw)
        except OSError as exc:
            self.error = errno.errorcode.get(exc.errno or 0, str(exc.errno))
        except self.rx.ReceiptError as exc:  # we built an invalid record: that is a runner bug
            raise InternalError("receipts.py rejected a record the runner built: %s" % exc)

    def header(self, **kw: Any) -> None:
        self._guard(self.writer.write_header if self.writer else None, **kw)

    def case(self, kw: Dict[str, Any]) -> None:
        self._guard(self.writer.write_case if self.writer else None, **kw)
        self.records += 1

    def footer(self) -> None:
        self._guard(self.writer.write_footer if self.writer else None)
        if self.fp is not None:
            try:
                self.fp.close()
            except OSError as exc:
                self.error = self.error or errno.errorcode.get(exc.errno or 0, str(exc.errno))


