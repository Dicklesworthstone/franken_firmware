_CASE_KEYS = {
    "id", "argv", "cwd", "tiers", "requirements", "timeout_s", "mandatory",
    "evidence_class", "env", "env_inherit", "expect", "required_stdout",
    "requires", "artifacts", "blocked", "max_output_bytes", "description",
