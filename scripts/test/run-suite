def repo_root() -> str:
    return os.path.realpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", ".."))


def default_artifact_root() -> str:
    return os.environ.get("FFW_ARTIFACT_ROOT") or os.path.join(repo_root(), "build", "test-runs")


def load_floor(rx: Any, path: str) -> Tuple[Dict[str, Dict[str, Any]], str]:
    """Read and validate an independent floor file; an unreadable or empty floor is a usage error."""
    try:
        with open(path, "rb") as fh:
            blob = fh.read(1024 * 1024 + 1)
    except OSError as exc:
        raise UsageError("cannot read --floor %s: %s" % (path, exc))
    if len(blob) > 1024 * 1024:
        raise UsageError("--floor file is larger than 1 MiB")
    try:
        doc = json.loads(blob.decode("utf-8"))
        if not isinstance(doc, dict) or not doc:
            raise ValueError("must be a non-empty JSON object {case_id: constraints}")
        rx.normalize_required(doc)
    except (ValueError, rx.ReceiptError) as exc:
        raise UsageError("--floor %s is not a valid floor: %s" % (path, exc))
    return {k: dict(v or {}) for k, v in doc.items()}, sha256_bytes(blob)


def parse_seed(text: str) -> int:
    if text == "random":
        return secrets.randbits(63)
    try:
        value = int(text, 10)
    except ValueError:
        raise UsageError("--seed must be a non-negative integer or 'random'")
    if not 0 <= value < 2**63:
        raise UsageError("--seed must be in [0, 2**63)")
    return value


def compute_coverage(registry: Registry, tier: Optional[str], selected: Sequence[Case]) -> Tuple[Dict[str, Any], List[str]]:
    by_req: Dict[str, List[str]] = {rid: [] for rid in registry.requirements}
    for c in selected:
        for rid in c.requirements:
            by_req.setdefault(rid, []).append(c.id)
    uncovered = []
    for rid, req in sorted(registry.requirements.items()):
        applies = tier is None or tier in req.tiers
        if applies and not by_req[rid]:
            uncovered.append(rid)
    table = {rid: {"text": registry.requirements[rid].text, "tiers": registry.requirements[rid].tiers,
                   "cases": sorted(ids)} for rid, ids in sorted(by_req.items()) if rid in registry.requirements}
    return table, uncovered


def cmd_list(args: argparse.Namespace) -> int:
    registry = load_registry(args.manifest, args.manifest_dir)
    entries, deselected, partial = select_cases(registry, args.tier, args.case)
    rows = [{"id": e.case.id if e.case else e.synthetic_id,
             "status_if_run": "not_run" if e.case is None else "planned",
             "reason": e.synthetic_reason,
             "requirements": e.case.requirements if e.case else [],
             "evidence_class": e.case.evidence_class if e.case else None} for e in entries]
    if args.json:
        print(json.dumps({"tier": args.tier, "planned": len(rows), "deselected": deselected,
                          "partial_selection": partial, "cases": rows}, indent=1, sort_keys=True))
    else:
        for r in rows:
            print("%s%s" % (r["id"], "" if r["status_if_run"] == "planned" else "  (%s)" % r["reason"]))
        print("planned=%d deselected=%d" % (len(rows), deselected))
    return EXIT_OK


def cmd_coverage(args: argparse.Namespace) -> int:
    registry = load_registry(args.manifest, args.manifest_dir)
    cases = [c for c in registry.cases if args.tier is None or args.tier in c.tiers]
    table, uncovered = compute_coverage(registry, args.tier, cases)
    print(json.dumps({"tier": args.tier, "requirements": table, "uncovered_requirements": uncovered},
                     indent=1, sort_keys=True))
    return EXIT_FAILED if uncovered else EXIT_OK


def _write_atomic(path: str, data: bytes) -> Optional[str]:
    tmp = path + ".tmp"
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        try:
            view = memoryview(data)
            while view:
                n = os.write(fd, view)
                view = view[n:]
        finally:
            os.close(fd)
        os.replace(tmp, path)
        return None
    except OSError as exc:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return errno.errorcode.get(exc.errno or 0, "OSError")


def cmd_run(args: argparse.Namespace) -> int:
    t0_ns = time.monotonic_ns()
    t0 = time.monotonic()
    started_utc = utc_now()
    rx, rx_sha = load_receipts()  # fail closed before any directory is created
    diag, diag_sha = load_diagnostics()
    registry = load_registry(args.manifest, args.manifest_dir)
    entries, deselected, partial = select_cases(registry, args.tier, args.case)
    run_seed = parse_seed(args.seed)
    floor_file: Dict[str, Dict[str, Any]] = {}
    floor_sha: Optional[str] = None
    if args.floor:
        if partial:
            raise UsageError("--floor cannot be combined with --case: a partial selection would silently skip it")
        floor_file, floor_sha = load_floor(rx, args.floor)

    if args.jobs < 1 or args.jobs > 64:
        raise UsageError("--jobs must be in [1, 64]")
    if not 0 <= args.retries <= 5:
        raise UsageError("--retries must be in [0, 5]")
    if not 0 < args.global_timeout_s <= MAX_CASE_TIMEOUT_S * 4:
        raise UsageError("--global-timeout-s out of range")
    if not 0 < args.case_timeout_cap_s <= MAX_CASE_TIMEOUT_S:
        raise UsageError("--case-timeout-cap-s out of range")
    if not 0 <= args.kill_grace_s <= 60:
        raise UsageError("--kill-grace-s must be in [0, 60]")
    if not 1024 <= args.max_output_bytes <= HARD_OUTPUT_CAP:
        raise UsageError("--max-output-bytes must be in [1024, %d]" % HARD_OUTPUT_CAP)
    for name in args.env_allow + args.redact_env:
        if not ENV_NAME_RE.match(name):
            raise UsageError("bad env var name %r" % name)
    if args.run_id is not None and not RUN_ID_RE.match(args.run_id):
        raise UsageError("--run-id must match %s" % RUN_ID_RE.pattern)

    literals = [os.environ[n] for n in args.redact_env if os.environ.get(n)]
    redactor = Redactor(literals, scrub_home=False)

    artifact_root = os.path.abspath(args.artifact_root or default_artifact_root())
    run_id = args.run_id or "%s-%d-%s" % (
        datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ"), os.getpid(), secrets.token_hex(3))
    run_dir = os.path.join(artifact_root, run_id)
    try:
        os.makedirs(artifact_root, exist_ok=True)
        os.mkdir(run_dir, 0o700)
    except FileExistsError:
        raise UsageError("run id %s already exists under %s; refusing to overwrite (reruns keep the original "
                         "failure evidence)" % (run_id, artifact_root))
    except OSError as exc:
        raise UsageError("cannot create run directory under %s: %s" % (artifact_root, exc))
    for sub in ("logs", "scratch"):
        try:
            os.mkdir(os.path.join(run_dir, sub), 0o700)
        except OSError as exc:
            raise UsageError("cannot create %s in the run directory: %s" % (sub, exc))

    sink = make_event_sink(diag, run_dir, run_id, t0_ns, len(entries), args.event_log_bytes, literals)

    prefix = [sys.executable, os.path.realpath(__file__), "run", "--tier", args.tier,
              "--artifact-root", artifact_root]
    for m in args.manifest:
        prefix += ["--manifest", os.path.abspath(m)]
    for m in args.manifest_dir:
        prefix += ["--manifest-dir", os.path.abspath(m)]
    for n in args.env_allow:
        prefix += ["--env-allow", n]
    for n in args.redact_env:
        prefix += ["--redact-env", n]

    cancel = threading.Event()
    hard = threading.Event()
    ctx = RunContext(
        run_id=run_id, run_dir=run_dir, tier=args.tier, run_seed=run_seed, redactor_literals=literals,
        events=sink, cancel=cancel, hard_cancel=hard, stop=threading.Event(),
        global_deadline=t0 + args.global_timeout_s, kill_grace_s=args.kill_grace_s, retries=args.retries,
        case_timeout_cap_s=args.case_timeout_cap_s, output_cap=args.max_output_bytes,
        env_allow=list(args.env_allow), replay_prefix=prefix, rx=rx, t0_ns=t0_ns,
    )
    ctx.fail_fast = bool(args.fail_fast)

    def on_signal(signum: int, _frame: Any) -> None:
        name = signal_name(signum)
        if cancel.is_set():
            hard.set()
        ctx.cancel_signal.append(name)
        cancel.set()

    old_handlers = {s: signal.signal(s, on_signal) for s in (signal.SIGINT, signal.SIGTERM)}

    sink.emit_event("run_start", critical=True, tier=args.tier, planned=len(entries), deselected=deselected,
              run_seed=run_seed, jobs=args.jobs, partial_selection=partial,
              timebase="time.monotonic_ns since run start", manifests=len(registry.manifests))

    # The receipt stream: header first (so even a crashed run leaves an honest, footer-less stream).
    expected = build_expected(entries)
    git = git_info(repo_root())
    stream = Stream(rx, os.path.join(run_dir, "receipts.jsonl"))
    if entries:
        header_artifacts: Dict[str, Dict[str, Any]] = {}
        for m in registry.manifests:
            digest = sha256_file(m["path"])
            if digest:
                name = artifact_name(m["path"])
                header_artifacts[name] = {"name": name, "sha256": digest, "size": os.path.getsize(m["path"])}
        for e in entries:
            if e.case is not None:
                refs = case_artifact_refs(e.case)
                ctx.artifact_refs[e.case.id] = refs   # reused verbatim for the case's records
                for ref in refs:
                    header_artifacts.setdefault(ref["name"], ref)
        versions = {"run-suite": RUNNER_VERSION, "python": sys.version.split()[0],
                    "platform": sys.platform, "receipts.py": rx_sha, "diagnostics.py": diag_sha}
        if git.get("head"):
            versions["git_head"] = str(git["head"])
        suite_names = sorted({e.case.suite for e in entries if e.case is not None}) or ["unnamed"]
        stream.header(run_id=run_id, suite="+".join(suite_names)[:120], tier=args.tier, seed=run_seed,
                      expected=expected, versions=versions,
                      artifacts=[header_artifacts[k] for k in sorted(header_artifacts)])

    records: List[Optional[Dict[str, Any]]] = [None] * len(entries)
    from concurrent.futures import ThreadPoolExecutor, wait as fut_wait
    try:
        with ThreadPoolExecutor(max_workers=args.jobs, thread_name_prefix="case") as pool:
            futures = {pool.submit(process_entry, ctx, e): i for i, e in enumerate(entries)}
            pending = set(futures)
            while pending:
                done, pending = fut_wait(pending, timeout=0.2)
                for fut in done:
                    idx = futures[fut]
                    try:
                        rec = fut.result()
                    except Exception as exc:  # a worker bug must not become a silent pass
                        entry = entries[idx]
                        cid = entry.case.id if entry.case else entry.synthetic_id
                        raise InternalError("worker crashed on case %s: %r" % (cid, exc))
                    records[idx] = rec
                    if entries[idx].case is not None:
                        for kw in case_stream_records(ctx, entries[idx].case, rec):  # type: ignore[arg-type]
                            stream.case(kw)
    finally:
        for s, h in old_handlers.items():
            signal.signal(s, h)

    final: List[Dict[str, Any]] = [r for r in records if r is not None]
    if len(final) != len(entries):
        raise InternalError("lost case records: %d of %d" % (len(final), len(entries)))

    cancelled = cancel.is_set()
    if cancelled:
        sink.emit_event("run_cancel", critical=True, signal=ctx.cancel_signal[0] if ctx.cancel_signal else "?")

    d = denominators(final, deselected)
    check_invariants(final, d)

    # Close the stream, then let the helper-owned aggregator judge it independently.  Its verdict
    # per case must equal what the runner's own bookkeeping predicts; a disagreement is a runner bug.
    agg: Optional[Dict[str, Any]] = None
    crosscheck: List[str] = []
    if entries:
        stream.footer()
        # The floor is declared in the manifests (required_cases), apart from the selection logic that
        # builds `expected`: if that logic ever dropped or demoted a required case, the aggregator says so.
        # An optional --floor file adds a floor from a source the manifests cannot edit (for Q00: derived
        # from oracles.DEFECTS by scripts/test/q00/floor.py).  Its constraints win over the bare manifest ids.
        merged: Dict[str, Dict[str, Any]] = {}
        if not partial:
            merged = {cid: {} for cid in registry.required_all + registry.required_by_tier.get(args.tier, [])}
            merged.update(floor_file)
        agg = rx.aggregate_path(stream.path, expected, max_attempts=args.retries + 1, required=merged or None)
        if not stream.error:
            for r in final:
                want = predicted_verdict(r)
                got = agg["cases"].get(r["id"], {}).get("verdict")
                if got != want:
                    crosscheck.append("%s: runner expects %s, aggregator says %s" % (r["id"], want, got))

    selected_cases = [e.case for e in entries if e.case is not None]
    if partial:
        table, uncovered = {}, []
    else:
        table, uncovered = compute_coverage(registry, args.tier, selected_cases)
    status_by_id = {r["id"]: r["status"] for r in final}
    for rid, row in table.items():
        row["cases"] = [{"id": cid, "status": status_by_id.get(cid)} for cid in row["cases"]]

    incomplete: List[str] = []
    if sink.critical_lost or sink.open_error:
        incomplete.append("critical_event_loss")
    if stream.error:
        incomplete.append("receipt_stream_write_failed")
    if agg is not None and not agg["complete"]:
        incomplete.append("receipt_stream_incomplete")
    for r in final:
        for a in r.get("attempts", []):
            if _lost(a):
                incomplete.append("critical_evidence_lost")
            if not a.get("group_clear", True) or a.get("capture_abandoned"):
                incomplete.append("process_cleanup_failed")
            if a.get("cleanup_error"):
                incomplete.append("scratch_cleanup_failed")
    incomplete = sorted(set(incomplete))

    def merged_verdict() -> Tuple[str, List[str]]:
        v, b = compute_verdict(final, d, uncovered, cancelled, incomplete)
        if v == "pass" and agg is not None and not agg["qualified"]:
            v = "fail"
            b = b + ["aggregator_unqualified:" + ",".join(agg["unqualified_reasons"])]
        if crosscheck:
            v, b = "internal_error", ["runner/aggregator disagreement: " + "; ".join(crosscheck[:10])]
        return v, b

    verdict, blocking = merged_verdict()
    sink.emit_event("run_end", critical=True, verdict=verdict,
                    **{k: d[k] for k in ("planned", "executed", "pass", "fail", "blocked", "not_run")})
    ev_verdict = sink.close(timeout=args.event_close_timeout_s)   # bounded: a hung target cannot hang the run
    # Two independent opinions on the event log: the sink's own accounting, and a re-read of the file itself
    # (header first, footer last, closure identity, no torn tail).  Either one failing makes the run INCOMPLETE.
    # A file-backed sink (always the case for the runner itself) MUST be re-readable: a missing or torn file fails.
    # An in-memory target (only ever substituted by tests) has no file, so only the sink's own verdict applies.
    audit = None
    if sink.path:
        audit = diag.audit_log(sink.path) if os.path.exists(sink.path) else None
        if audit is None or not audit.complete:
            incomplete.append("event_log_audit_failed")
    if not ev_verdict.complete:
        incomplete.append("event_log_incomplete")
    incomplete = sorted(set(incomplete))
    verdict, blocking = merged_verdict()   # final: now that the event log's own fate is known

    by_class: Dict[str, Dict[str, int]] = {}
    for r in final:
        cls = r.get("evidence_class") or "unknown"
        row = by_class.setdefault(cls, {"planned": 0, "pass": 0, "fail": 0, "blocked": 0, "not_run": 0})
        row["planned"] += 1
        row[r["status"]] += 1
    breakdown = collections.Counter(r["reason"] for r in final if r["status"] != "pass")

    events_stats = {
        "path": sink.path, "verdict": ev_verdict.as_dict(), "stats": sink.stats(),
        "summary": sink.summary_record(), "audit": audit.as_dict() if audit is not None else None,
    }

    receipt = {
        "schema": RECEIPT_SCHEMA,
        "runner": {"name": RUNNER_NAME, "version": RUNNER_VERSION,
                   "python": sys.version.split()[0], "platform": sys.platform},
        "run": {"id": run_id, "tier": args.tier, "seed": run_seed, "partial_selection": partial,
                "jobs": args.jobs, "retries": args.retries, "fail_fast": bool(args.fail_fast),
                "global_timeout_s": args.global_timeout_s, "started_utc": started_utc,
                "finished_utc": utc_now(), "duration_ms": int((time.monotonic() - t0) * 1000),
                "cancelled": ctx.cancel_signal[0] if cancelled and ctx.cancel_signal else None},
        "timebase": {"clock": "time.monotonic_ns", "origin": "run start", "unit": "ns",
                     "note": "wall-clock timestamps are informational only; durations use the monotonic clock"},
        "replay": {"suite": " ".join(shlex.quote(p) for p in prefix + ["--seed", str(run_seed)])},
        "git": git,
        "manifests": registry.manifests,
        "denominators": d,
        "receipts": {
            "stream": stream.path, "stream_error": stream.error, "records": stream.records,
            "registry_digest": rx.registry_digest(expected) if entries else None,
            "aggregator": None if agg is None else {
                "qualified": agg["qualified"], "complete": agg["complete"],
                "unqualified_reasons": agg["unqualified_reasons"], "denominator": agg["denominator"],
                "counts": agg["counts"], "by_proof_class": agg["by_proof_class"],
                "problems_total": agg["problems_total"], "problems": agg["problems"][:20],
                "evidence_sha256": agg["evidence_sha256"]},
            "crosscheck_mismatches": crosscheck,
            "floor": None if not args.floor else {
                "path": os.path.abspath(args.floor), "sha256": floor_sha, "cases": len(floor_file),
                "violations": (agg or {}).get("required")},
        },
        "by_evidence_class": by_class,
        "failure_breakdown": dict(sorted(breakdown.items())),
        "verdict": verdict,
        "blocking": blocking[:200],
        "uncovered_requirements": uncovered,
        "requirements": table,
        "evidence": {"complete": not incomplete, "incomplete_reasons": incomplete, "events": events_stats},
        "cases": final,
    }
    receipt = clip_obj(redactor.redact_obj(receipt), 16384)
    try:
        os.rmdir(os.path.join(run_dir, "scratch"))  # empty when every case cleaned up after itself
    except OSError:
        pass

    receipt_path = os.path.join(run_dir, "receipt.json")
    blob = (json.dumps(receipt, indent=1, sort_keys=True) + "\n").encode("utf-8")
    err = _write_atomic(receipt_path, blob)
    receipt_sha: Optional[str] = None
    if err:
        incomplete.append("receipt_write_failed")
        receipt["evidence"]["complete"] = False
        receipt["evidence"]["incomplete_reasons"] = sorted(set(incomplete))
        receipt["verdict"], receipt["blocking"] = compute_verdict(final, d, uncovered, cancelled, sorted(set(incomplete)))
        receipt_path = None
    else:
        receipt_sha = sha256_bytes(blob)
    summary = render_summary(receipt, receipt_path, receipt_sha)
    if err:
        summary += "receipt could not be written (%s); this stdout summary is the only record\n" % err
    else:
        serr = _write_atomic(os.path.join(run_dir, "summary.txt"), summary.encode("utf-8"))
        if serr:
            summary += "summary.txt could not be written (%s)\n" % serr
    if not args.quiet:
        sys.stdout.write(summary)
        sys.stdout.flush()

    if receipt["verdict"] == "internal_error":
        sys.stderr.write("run-suite: INTERNAL ERROR: %s\n" % "; ".join(crosscheck[:5]))
        return EXIT_INTERNAL
    if receipt["verdict"] == "cancelled":
        return EXIT_CANCELLED
    if receipt["verdict"] == "incomplete":
        return EXIT_INCOMPLETE
    return EXIT_OK if receipt["verdict"] == "pass" else EXIT_FAILED


