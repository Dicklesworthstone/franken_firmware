{
 "schema": "ffw.suite.v1",
 "suite": "q00",
 "description": "Q00 independent-oracle canaries and their paired positives, run through run-suite. The authoritative floor is derived separately by scripts/test/q00/floor.py.",
 "requirements": {
  "Q00.AC1.canaries": {
   "text": "Independent oracle canaries fail for wrong samples, stale epochs, double-applied commands and false-ready state, each with its exact expected oracle and violation kind.",
   "tiers": [
    "smoke",
    "full"
   ]
  },
  "Q00.AC1.positives": {
   "text": "Each independent oracle accepts the paired good behaviour and proves its guard was exercised.",
   "tiers": [
    "smoke",
    "full"
   ]
  }
 },
 "required_cases": [
  "q00.oracle.canary.sample_loss",
  "q00.oracle.canary.wrong_samples",
  "q00.oracle.canary.repeated_samples",
  "q00.oracle.canary.truncate_tail",
  "q00.oracle.canary.stale_epoch",
  "q00.oracle.canary.double_apply",
  "q00.oracle.canary.false_ready_early",
  "q00.oracle.canary.false_ready_stuck",
  "q00.oracle.canary.never_ready",
  "q00.oracle.canary.stop_behind_queue",
  "q00.oracle.positive.sample",
  "q00.oracle.positive.epoch",
  "q00.oracle.positive.command",
  "q00.oracle.positive.readiness",
  "q00.oracle.positive.priority_stop"
 ],
 "cases": [
  {
   "tiers": [
    "smoke",
    "full"
   ],
   "timeout_s": 60,
   "id": "q00.oracle.canary.sample_loss",
   "argv": [
    "{python}",
    "-I",
    "{manifest_dir}/test_support/oracles.py",
    "replay",
    "--defect",
    "sample_loss"
   ],
   "requirements": [
    "Q00.AC1.canaries"
   ],
   "expect": {
    "kind": "fail",
    "oracle": "sample",
    "violation": "lost_samples",
    "exit_codes": [
     1
    ]
   },
   "description": "planted defect: a delivered block is silently discarded with no gap announced"
  },
  {
   "tiers": [
    "smoke",
    "full"
   ],
   "timeout_s": 60,
   "id": "q00.oracle.canary.wrong_samples",
   "argv": [
    "{python}",
