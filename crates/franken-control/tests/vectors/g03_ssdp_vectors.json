{
 "schema": "ffw.g03.ssdp-vectors.v1",
 "about": "Hand-written expectations for fsonos/ssdp.rs (G03 slice 2). The service URNs and paths are those of fsonos/soap.rs; the SSDP shapes are those of the UPnP Device Architecture 1.0. Nothing here is a capture of a device or a real controller: the address is from the documentation range and every id is synthetic.",
 "device": {
  "uuid": "00000000-0000-4000-8000-00000000a1b2",
  "address": [
   192,
   0,
   2,
   10
  ],
  "port": 1400,
  "name": "Test Room",
  "max_age": 1800
 },
 "location": "http://192.0.2.10:1400/xml/device_description.xml",
 "parse": [
  {
   "id": "ssdp-multicast-all",
   "start": "M-SEARCH * HTTP/1.1",
   "headers": [
    [
     "HOST",
     "239.255.255.250:1900"
    ],
    [
     "MAN",
     "\"ssdp:discover\""
    ],
    [
     "MX",
     "3"
    ],
    [
     "ST",
     "ssdp:all"
    ]
   ],
   "expect": {
    "search": {
     "target": "ssdp:all",
     "mx": 3
    }
   }
  },
  {
   "id": "ssdp-rootdevice-mx-120-is-answered-as-5",
