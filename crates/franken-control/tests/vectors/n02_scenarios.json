{
  "schema": "ffw.n02.scenarios.v1",
  "notes": [
    "Golden scenarios for the N02 control channel (bead ffw-ugf). Each `expect` was worked out by hand from docs/contracts/n02.md before any implementation produced it.",
    "They are replayed by tests/n02/reference.py (an independently structured model) and by the Rust channel (crates/franken-control, test `replay`). A disagreement between any two of the three is a finding.",
    "Start state of every scenario: group epoch 10, state revision 2, members kitchen and den at volume 50 and unmuted, group master volume 50, nothing stopped.",
    "Peers: ctl-a and ctl-b (remote controllers, keys bound to epoch 10), panel (the local user, not epoch-bound), rogue (a remote controller whose key is bound to epoch 900).",
    "Times are in milliseconds. A rate limit [burst, interval_ms] allows `burst` actions at once and one more per interval.",
    "These are host-simulation vectors for a message-handling state machine. They say nothing about a network, a real MAC, or a board."
  ],
  "base_config": {
    "ordinary_capacity": 64,
    "priority_shared_capacity": 4,
    "priority_local_reserved": 2,
    "ledger_capacity": 128,
    "retention_ms": 30000,
    "pending_ttl_ms": 5000,
    "max_per_step": 4,
    "ordinary_rate": [100000, 1],
    "priority_rate": [100000, 1]
  },
  "signing_vectors": [
    {
      "id": "N02-W001",
      "what": "relative member volume with an expected revision (also pinned by a hand-written Rust unit test)",
      "peer": "ctl-a", "seq": 7, "epoch": 3, "rev": 12,
      "cmd": {"kind": "adjust_member_volume", "member": "kitchen", "delta": -5},
      "hex": "46464350010563746c2d610000000000000007000000000000000301000000000000000c03076b69746368656efb"},
    {
      "id": "N02-W002",
      "what": "stop without an expected revision",
      "peer": "panel", "seq": 1, "epoch": 10, "rev": null,
      "cmd": {"kind": "stop", "now_ns": 256, "tail_ns": 65535},
      "hex": "46464350010570616e656c0000000000000001000000000000000a00060000000000000100000000000000ffff"},
    {
      "id": "N02-W003",
      "what": "cancel naming an earlier command",
      "peer": "ctl-b", "seq": 300, "epoch": 11, "rev": null,
      "cmd": {"kind": "cancel", "target_seq": 299},
      "hex": "46464350010563746c2d62000000000000012c000000000000000b0007000000000000012b"},
    {
      "id": "N02-W004",
      "what": "mute with a one-byte flag",
      "peer": "panel", "seq": 2, "epoch": 0, "rev": null,
      "cmd": {"kind": "set_member_mute", "member": "den", "muted": true},
      "hex": "46464350010570616e656c0000000000000002000000000000000000050364656e01"},
    {
      "id": "N02-W005",
      "what": "absolute group volume at the top of the range, with an expected revision",
      "peer": "ctl-a", "seq": 1, "epoch": 10, "rev": 2,
      "cmd": {"kind": "set_group_volume", "volume": 100},
      "hex": "46464350010563746c2d610000000000000001000000000000000a0100000000000000020264"}
  ],
  "scenarios": [
    {
      "id": "N02-S001",
      "title": "the acknowledgement is lost after the commit; the retry gets the recorded outcome and nothing is applied twice",
      "invariants": ["INV-LOST-ACK", "INV-ONE-EFFECT"],
      "config": {},
      "steps": [
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 1, "epoch": 10, "rev": 2, "cmd": {"kind": "adjust_member_volume", "member": "kitchen", "delta": 10}, "expect": "queued:ordinary"},
        {"op": "step", "at_ms": 0, "expect": ["ctl-a#1=committed:3"]},
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 1, "epoch": 10, "rev": 2, "cmd": {"kind": "adjust_member_volume", "member": "kitchen", "delta": 10}, "expect": "settled:committed:3"},
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 1, "epoch": 10, "rev": 2, "cmd": {"kind": "adjust_member_volume", "member": "kitchen", "delta": 10}, "expect": "settled:committed:3"},
        {"op": "step", "at_ms": 0, "expect": []}
      ],
      "final": {"revision": 3, "epoch": 10, "group_volume": 50, "kitchen": 60, "den": 50, "muted": [], "stopped": false}
    },
    {
      "id": "N02-S002",
      "title": "a duplicate relative volume produces one effect whether the copy arrives before or after the command is applied",
      "invariants": ["INV-DUP-RELATIVE", "INV-ONE-EFFECT"],
      "config": {},
      "steps": [
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 1, "epoch": 10, "rev": 2, "cmd": {"kind": "adjust_member_volume", "member": "kitchen", "delta": 10}, "expect": "queued:ordinary"},
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 1, "epoch": 10, "rev": 2, "cmd": {"kind": "adjust_member_volume", "member": "kitchen", "delta": 10}, "expect": "already_queued:ordinary"},
        {"op": "step", "at_ms": 0, "expect": ["ctl-a#1=committed:3"]},
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 1, "epoch": 10, "rev": 2, "cmd": {"kind": "adjust_member_volume", "member": "kitchen", "delta": 10}, "expect": "settled:committed:3"}
      ],
      "final": {"revision": 3, "epoch": 10, "group_volume": 50, "kitchen": 60, "den": 50, "muted": [], "stopped": false}
    },
    {
      "id": "N02-S003",
      "title": "after the retention window a retry is explicitly unknown and is not applied again",
      "invariants": ["INV-WINDOW-AGE", "INV-NOT-FOREVER"],
      "config": {"retention_ms": 1000},
      "steps": [
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 1, "epoch": 10, "rev": 2, "cmd": {"kind": "adjust_member_volume", "member": "kitchen", "delta": 10}, "expect": "queued:ordinary"},
        {"op": "step", "at_ms": 0, "expect": ["ctl-a#1=committed:3"]},
        {"op": "submit", "at_ms": 999, "peer": "ctl-a", "seq": 1, "epoch": 10, "rev": 2, "cmd": {"kind": "adjust_member_volume", "member": "kitchen", "delta": 10}, "expect": "settled:committed:3"},
        {"op": "submit", "at_ms": 1000, "peer": "ctl-a", "seq": 1, "epoch": 10, "rev": 2, "cmd": {"kind": "adjust_member_volume", "member": "kitchen", "delta": 10}, "expect": "out_of_window:1"},
        {"op": "step", "at_ms": 1000, "expect": []},
        {"op": "submit", "at_ms": 1000, "peer": "ctl-a", "seq": 1, "epoch": 10, "rev": 2, "cmd": {"kind": "adjust_member_volume", "member": "kitchen", "delta": 10}, "expect": "out_of_window:1"}
      ],
      "final": {"revision": 3, "epoch": 10, "group_volume": 50, "kitchen": 60, "den": 50, "muted": [], "stopped": false}
    },
    {
      "id": "N02-S004",
      "title": "a full ledger forgets its oldest outcome and says so; newer ones are still answered",
      "invariants": ["INV-WINDOW-COUNT", "INV-NOT-FOREVER"],
      "config": {"ledger_capacity": 2},
      "steps": [
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 1, "epoch": 10, "rev": null, "cmd": {"kind": "set_group_volume", "volume": 61}, "expect": "queued:ordinary"},
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 2, "epoch": 10, "rev": null, "cmd": {"kind": "set_group_volume", "volume": 62}, "expect": "queued:ordinary"},
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 3, "epoch": 10, "rev": null, "cmd": {"kind": "set_group_volume", "volume": 63}, "expect": "queued:ordinary"},
        {"op": "step", "at_ms": 0, "expect": ["ctl-a#1=committed:3", "ctl-a#2=committed:4", "ctl-a#3=committed:5"]},
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 1, "epoch": 10, "rev": null, "cmd": {"kind": "set_group_volume", "volume": 61}, "expect": "out_of_window:1"},
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 3, "epoch": 10, "rev": null, "cmd": {"kind": "set_group_volume", "volume": 63}, "expect": "settled:committed:5"}
      ],
      "final": {"revision": 5, "epoch": 10, "group_volume": 63, "kitchen": 50, "den": 50, "muted": [], "stopped": false}
    },
    {
      "id": "N02-S005",
      "title": "a stale leader cannot alter a group whose epoch has moved on; rebinding its key to the new epoch restores it",
      "invariants": ["INV-STALE-LEADER", "INV-EXPIRED-AUTHORITY"],
      "config": {},
      "steps": [
        {"op": "session_epoch", "epoch": 11},
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 1, "epoch": 10, "rev": null, "cmd": {"kind": "set_group_volume", "volume": 5}, "expect": "queued:ordinary"},
        {"op": "step", "at_ms": 0, "expect": ["ctl-a#1=refused:stale_epoch"]},
        {"op": "rebind", "peer": "ctl-a", "epoch": 11},
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 2, "epoch": 11, "rev": null, "cmd": {"kind": "set_group_volume", "volume": 5}, "expect": "queued:ordinary"},
        {"op": "step", "at_ms": 0, "expect": ["ctl-a#2=committed:4"]}
      ],
      "final": {"revision": 4, "epoch": 11, "group_volume": 5, "kitchen": 50, "den": 50, "muted": [], "stopped": false}
    },
    {
      "id": "N02-S006",
      "title": "a key bound to one epoch is refused under another, and an epoch jump from a peer bound to one is refused and never fences the group",
      "invariants": ["INV-EPOCH-BINDING", "INV-NO-EPOCH-ADVANCE"],
      "config": {},
      "steps": [
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 1, "epoch": 9, "rev": null, "cmd": {"kind": "set_group_volume", "volume": 5}, "expect": "rejected:epoch_not_bound"},
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 1, "epoch": 11, "rev": null, "cmd": {"kind": "set_group_volume", "volume": 5}, "expect": "rejected:epoch_not_bound"},
        {"op": "submit", "at_ms": 0, "peer": "rogue", "seq": 1, "epoch": 900, "rev": null, "cmd": {"kind": "set_group_volume", "volume": 1}, "expect": "queued:ordinary"},
        {"op": "step", "at_ms": 0, "expect": ["rogue#1=refused:epoch_ahead"]}
      ],
      "final": {"revision": 2, "epoch": 10, "group_volume": 50, "kitchen": 50, "den": 50, "muted": [], "stopped": false}
    },
    {
