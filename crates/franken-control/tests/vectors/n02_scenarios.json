        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 1, "epoch": 10, "rev": 2, "cmd": {"kind": "adjust_member_volume", "member": "kitchen", "delta": 10}, "expect": "settled:refused:revision_mismatch"}
