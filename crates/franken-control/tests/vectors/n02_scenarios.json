        {"op": "submit", "at_ms": 0, "peer": "ctl-b", "seq": 1, "epoch": 10, "rev": 2, "cmd": {"kind": "adjust_member_volume", "member": "kitchen", "delta": 20}, "expect": "queued:ordinary"},
        {"op": "submit", "at_ms": 0, "peer": "ctl-a", "seq": 1, "epoch": 10, "rev": 2, "cmd": {"kind": "adjust_member_volume", "member": "kitchen", "delta": 10}, "expect": "queued:ordinary"},
