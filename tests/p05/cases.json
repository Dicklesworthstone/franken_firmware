 "invariants": [
  {
   "id": "INV-WHOLE-VALUE",
   "text": "every operation reads or writes all 64 bits under one lock: no tearing, no truncation, carry and borrow cross the 32-bit boundary, compare-exchange compares full width",
   "cases": [
    "P05-DIR-001",
    "P05-DIR-004",
    "P05-DIR-007"
   ],
   "rust_tests": [
    "p05_vector_load_store_roundtrip_above_u32",
    "p05_vector_fetch_add_carries_across_the_32_bit_boundary",
    "p05_vector_compare_exchange_is_full_width",
    "p05_vector_swap_max_min_and_bit_ops"
   ]
  },
  {
   "id": "INV-LINEARIZABLE-SEEDED",
   "text": "the real cell is linearizable on every seeded interleaving; the Rust model reproduces the independent reference's pinned counts",
   "cases": [
    "P05-VEC-001"
   ],
   "rust_tests": [
    "p05_model_good_cell_is_linearizable_on_every_seed"
   ]
  },
  {
   "id": "INV-LINEARIZABLE-THREADS",
   "text": "with real threads under contention: histories are linearizable, fetch_add is unique and complete, a compare-exchange loop loses no update across the word boundary",
   "cases": [],
   "rust_tests": [
    "p05_threads_history_is_linearizable",
    "p05_threads_fetch_add_is_unique_and_complete",
    "p05_threads_compare_exchange_loop_loses_no_update_across_the_word_boundary"
   ]
  },
  {
   "id": "INV-TYPED-RANGE",
   "text": "overflow, underflow and wrap are typed and leave the cell unchanged; wrapping exists only under an explicit name; signed ranges are checked in both directions",
   "cases": [],
   "rust_tests": [
    "p05_vector_checked_add_overflow_is_typed_and_leaves_value",
    "p05_vector_checked_sub_underflow_is_typed_and_leaves_value",
    "p05_vector_wrapping_ops_are_named_and_wrap_like_u64",
    "p05_vector_i64_signed_range",
    "p05_threads_checked_add_overflow_race_is_typed"
   ]
  },
  {
   "id": "INV-NEVER-REUSE-IDENTIFIER",
   "text": "an identifier sequence never wraps and never issues the same value twice, alone or under contention, and u64::MAX is the exhausted state",
   "cases": [],
   "rust_tests": [
    "p05_sequence_never_wraps_and_reserves_max",
    "p05_threads_sequence_exhaustion_is_exact"
   ]
  },
  {
   "id": "INV-PLANT-SPLIT-CAUGHT",
   "text": "a naive split-word version (two 32-bit atomics) fails the same checks the real cell passes: seeded sweep and directed scripts",
   "cases": [
    "P05-PLANT-001",
    "P05-DIR-002",
    "P05-DIR-005",
    "P05-DIR-008"
   ],
   "rust_tests": [
    "p05_model_split_word_is_caught_where_the_reference_says",
    "p05_model_directed_scripts_match_hand_written_table"
   ]
  },
  {
   "id": "INV-PLANT-TRUNC-CAUGHT",
   "text": "a truncating version (one 32-bit atomic, values cut with as u32) fails the same checks the real cell passes",
   "cases": [
    "P05-PLANT-002",
    "P05-DIR-003",
    "P05-DIR-006",
    "P05-DIR-009"
   ],
   "rust_tests": [
    "p05_model_truncating_is_caught_where_the_reference_says",
    "p05_model_directed_scripts_match_hand_written_table"
   ]
  },
  {
   "id": "INV-CHECKER-NOT-VACUOUS",
   "text": "the linearizability checker accepts legal histories, rejects illegal ones, treats an exhausted budget as inconclusive, and each deliberately weakened checker rule is caught by a named case",
   "cases": [
    "P05-CHK-*",
    "P05-MUT-*"
   ],
   "rust_tests": [
    "p05_checker_accepts_legal_and_rejects_illegal_histories",
    "p05_checker_budget_exhaustion_is_inconclusive_not_a_pass"
   ]
  },
  {
   "id": "INV-BOUNDED-CRITICAL-SECTION",
   "text": "no caller code runs under the lock; a poisoned lock keeps the whole value; try_* answers Contended instead of blocking when the lock is held (re-entrancy, signal-handler shape)",
   "cases": [],
   "rust_tests": [
    "p05_poisoned_lock_keeps_the_whole_value",
    "p05_try_ops_report_contention_instead_of_blocking",
    "p05_try_ops_work_on_a_poisoned_idle_lock"
   ]
  },
  {
   "id": "INV-LOCAL-STATE",
