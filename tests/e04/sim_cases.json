  {
   "id": "E04-SIM-001",
   "title": "exclusive ownership: a second owner is refused, release, then restart",
   "steps": [
    {
     "ev": {
      "type": "acquire",
      "owner": "a"
     },
     "expect": {
      "result": "ok"
     }
    },
    {
     "ev": {
      "type": "acquire",
      "owner": "b"
     },
     "expect": {
      "result": "refused",
      "reason": "busy"
     }
    },
    {
     "ev": {
      "type": "release_device",
      "owner": "b"
     },
     "expect": {
      "result": "refused",
      "reason": "not_owner"
     }
    },
    {
     "ev": {
      "type": "release_device",
      "owner": "a"
     },
     "expect": {
      "result": "ok"
     }
    },
    {
     "ev": {
      "type": "acquire",
      "owner": "b"
     },
     "expect": {
      "result": "ok"
     }
    }
   ],
   "final": {
    "phase": "closed",
    "amp": "muted",
    "owner": "b",
    "slots": [],
    "submitted": 0,
    "consumed": 0
   }
  },
