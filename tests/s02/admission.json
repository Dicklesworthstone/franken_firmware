{
 "schema": "ffw.s02.admission.v1",
 "note": "Hand-written verdicts of the S02 admission function (crates/franken-codec/src/admission.rs), independent of the Rust. Each refusal case has every other input satisfied, so it tests one check; each check also has an admitted twin or a boundary pair. The ledger is tests/s02/negotiated.json (pins: librespot v0.8.0, shairport-sync 5.6.2, Symphonia v0.6.1). Nothing here is a decode result.",
 "limits": {
  "format_name_max": 32,
  "config_max": 64,
  "echo_alphabet": "A-Z a-z 0-9 _ . - ; every other byte is echoed as ?"
 },
 "check_order": [
  "format_name_length",
  "format_lookup",
  "rate",
  "channels",
  "bits",
  "config_size",
  "config_shape"
 ],
 "codes": [
  "BITS_MISMATCH",
  "BLOCKED_MULTICHANNEL",
  "CHANNELS_NOT_NEGOTIATED",
  "CONFIG_INVALID",
  "CONFIG_MISMATCH",
  "CONFIG_MISSING",
  "CONFIG_TOO_LARGE",
  "CONFIG_UNEXPECTED",
  "FORMAT_NAME_TOO_LONG",
  "NOT_A_SOURCE_FORMAT",
  "NOT_REQUESTED_BY_PIN",
  "RATE_NOT_NEGOTIATED",
  "UNKNOWN_FORMAT",
  "UNSUPPORTED_PROFILE"
 ],
 "cases": [
