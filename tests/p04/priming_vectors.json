{
 "schema": "ffw.p04.priming_vectors.v1",
 "note": "Hand-traced scenarios for the optional silence-priming gate in HalSession::start (docs/contracts/p04.md, Silence priming). Replayed by the independent Python model in priming_ref.py; each scenario names the Rust test in crates/franken-hal/src/session.rs that drives the real HalSession through the same steps. A block is 16 bytes (4 frames of 2 channels of 2 bytes); 'silence' is 16 zero bytes, 'short_silence' is 8, 'almost_silence' is 16 bytes with only the last non-zero, 'tone' is 16 non-zero bytes. 'take' is how much of the block the device accepts. The gate is a host model: it says nothing about what a board needs.",
 "traces": [
  {"id": "P04-PRM-001", "what": "with no requirement configured, start unmutes at once and nothing was primed", "abi": "retained", "required": 0,
   "steps": [["start"]],
   "expect": {"outputs": ["started"], "final": {"phase": "running", "amp": "unmuted", "unmute_calls": 1, "primed": 0}},
   "rust_test": "session::silence_priming_is_off_by_default_so_start_is_unchanged"},
  {"id": "P04-PRM-002", "what": "an unprimed start is refused by name and the device is never told to unmute", "abi": "retained", "required": 2,
   "steps": [["start"]],
   "expect": {"outputs": ["refused 0/2"], "final": {"phase": "prepared", "amp": "muted", "unmute_calls": 0, "primed": 0}},
   "rust_test": "session::start_refuses_an_unprimed_unmute_by_name_and_the_backend_never_sees_an_unmute"},
  {"id": "P04-PRM-003", "what": "a tone, a short block of silence and a block with one non-zero sample do not count", "abi": "retained", "required": 2,
   "steps": [["submit", "tone", "all"], ["submit", "short_silence", "all"], ["submit", "almost_silence", "all"], ["start"]],
   "expect": {"outputs": ["primed=0", "primed=0", "primed=0", "refused 0/2"], "final": {"phase": "prepared", "amp": "muted", "unmute_calls": 0, "primed": 0}},
   "rust_test": "session::only_a_whole_all_zero_block_counts_as_priming"},
  {"id": "P04-PRM-004", "what": "a block of silence the device took only half of, or none of, does not count", "abi": "retained", "required": 2,
   "steps": [["submit", "silence", "half"], ["submit", "silence", "none"], ["start"]],
   "expect": {"outputs": ["primed=0", "primed=0", "refused 0/2"], "final": {"phase": "prepared", "amp": "muted", "unmute_calls": 0, "primed": 0}},
   "rust_test": "session::a_block_the_device_took_only_part_of_or_none_of_does_not_count_as_priming"},
  {"id": "P04-PRM-005", "what": "two whole silent blocks open the gate, one is refused as 1/2, and the amp unmutes once", "abi": "retained", "required": 2,
   "steps": [["submit", "silence", "all"], ["start"], ["submit", "silence", "all"], ["start"]],
   "expect": {"outputs": ["primed=1", "refused 1/2", "primed=2", "started"], "final": {"phase": "running", "amp": "unmuted", "unmute_calls": 1, "primed": 0}},
   "rust_test": "session::enough_whole_silent_blocks_open_the_gate_and_the_amp_unmutes_once"},
  {"id": "P04-PRM-006", "what": "silence submitted after the unmute is not priming", "abi": "retained", "required": 1,
   "steps": [["submit", "silence", "all"], ["start"], ["submit", "silence", "all"]],
   "expect": {"outputs": ["primed=1", "started", "primed=0"], "final": {"phase": "running", "amp": "unmuted", "unmute_calls": 1, "primed": 0}},
   "rust_test": "session::silence_submitted_while_unmuted_is_not_priming"},
  {"id": "P04-PRM-007", "what": "a stop the device acknowledges discards the priming", "abi": "retained", "required": 1,
   "steps": [["submit", "silence", "all"], ["drain"], ["start"]],
   "expect": {"outputs": ["primed=1", "prepared primed=0", "refused 0/1"], "final": {"phase": "prepared", "amp": "muted", "unmute_calls": 0, "primed": 0}},
   "rust_test": "session::a_flush_acknowledgment_discards_the_priming"},
  {"id": "P04-PRM-008", "what": "a fault discards the priming at once, and the reset after it does not bring it back", "abi": "retained", "required": 1,
   "steps": [["submit", "silence", "all"], ["fault"], ["reset"], ["start"]],
   "expect": {"outputs": ["primed=1", "faulted primed=0", "prepared primed=0", "refused 0/1"], "final": {"phase": "prepared", "amp": "muted", "unmute_calls": 0, "primed": 0}},
   "rust_test": "session::a_fault_discards_the_priming_and_a_reset_does_not_bring_it_back"},
  {"id": "P04-PRM-009", "what": "a reset the device acknowledges discards the priming on the path that never saw a flush acknowledgment", "abi": "retained", "required": 1,
   "steps": [["submit", "silence", "all"], ["abort"], ["reset"], ["start"]],
   "expect": {"outputs": ["primed=1", "draining", "prepared primed=0", "refused 0/1"], "final": {"phase": "prepared", "amp": "muted", "unmute_calls": 0, "primed": 0}},
   "rust_test": "session::a_reset_acknowledgment_discards_the_priming"},
  {"id": "P04-PRM-010", "what": "a vanished device discards the priming", "abi": "retained", "required": 1,
   "steps": [["submit", "silence", "all"], ["lose"]],
   "expect": {"outputs": ["primed=1", "lost primed=0"], "final": {"phase": "faulted", "amp": "unknown", "unmute_calls": 0, "primed": 0}},
   "rust_test": "session::a_lost_device_discards_the_priming"},
  {"id": "P04-PRM-011", "what": "a copying-write ABI counts priming by the same rule", "abi": "copying", "required": 2,
   "steps": [["submit", "tone", "all"], ["submit", "silence", "all"], ["submit", "silence", "all"], ["start"]],
   "expect": {"outputs": ["primed=0", "primed=1", "primed=2", "started"], "final": {"phase": "running", "amp": "unmuted", "unmute_calls": 1, "primed": 0}},
   "rust_test": "session::a_copying_abi_counts_priming_the_same_way"}
 ]
}
