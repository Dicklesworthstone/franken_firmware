{
  "schema": "ffw.n02.cases.v1",
  "bead": "ffw-ugf",
  "notes": [
    "Maps every N02 invariant to the golden scenarios that exercise it (crates/franken-control/tests/vectors/n02_scenarios.json) and to the Rust tests under crates/franken-control/src/channel that check it.",
    "tests/n02/test_reference_model.py verifies the mapping: each scenario names only declared invariants, each invariant has at least one scenario, each listed Rust test exists, and docs/contracts/n02.md mentions each invariant.",
    "Everything here is host simulation of a message-handling state machine. It says nothing about a network, a real MAC, a board or an audible result."
  ],
  "invariants": [
    {
      "id": "INV-AUTH-FIRST",
      "claim": "A request that does not authenticate changes nothing: no queue, no ledger entry, no rate-limit allowance.",
      "scenarios": [
        "N02-S011",
        "N02-S014",
        "N02-S019"
      ],
      "rust_tests": [
        "a_forged_or_unknown_or_revoked_peer_changes_nothing",
        "a_flood_of_forgeries_cannot_spend_the_real_peers_allowance",
        "changing_any_single_signed_field_voids_the_proof",
        "authentication_changes_no_state",
        "the_hmac_primitive_matches_the_published_test_vectors",
        "a_proof_is_hmac_sha256_over_the_context_label_then_the_message",
        "a_proof_of_the_wrong_length_is_refused_even_when_it_is_a_prefix_of_the_right_one",
        "the_proof_is_sensitive_to_every_input",
        "a_key_shorter_than_the_minimum_is_refused_without_echoing_it",
        "the_proofs_match_the_python_hmac_vectors_and_the_directory_accepts_them",
        "every_tampered_field_is_refused_under_the_original_tag"
      ]
    },
    {
      "id": "INV-LOST-ACK",
      "claim": "When the acknowledgement of a committed command is lost, the retry is answered with the recorded outcome and the command is not applied again.",
      "scenarios": [
        "N02-S001"
      ],
      "rust_tests": [
        "a_lost_acknowledgement_after_commit_is_answered_with_the_same_outcome_and_no_second_effect"
      ]
    },
    {
      "id": "INV-ONE-EFFECT",
      "claim": "However many times a command is delivered, it takes effect at most once.",
      "scenarios": [
        "N02-S001",
        "N02-S002",
        "N02-S020",
        "N02-S021",
        "N02-S025"
      ],
      "rust_tests": [
        "a_lost_acknowledgement_after_commit_is_answered_with_the_same_outcome_and_no_second_effect",
        "a_retry_storm_leaves_the_queue_and_the_ledger_bounded"
      ]
    },
    {
      "id": "INV-DUP-RELATIVE",
      "claim": "A duplicated relative volume change applies exactly one delta, whether the copy arrives before or after the original is applied.",
      "scenarios": [
        "N02-S002"
      ],
      "rust_tests": [
        "a_duplicate_relative_volume_has_exactly_one_logical_effect_whenever_the_copy_arrives",
        "without_the_ledger_the_copy_would_have_been_refused_as_a_stale_revision"
      ]
    },
    {
      "id": "INV-RETRY-STORM",
      "claim": "A storm of retries leaves queue length and ledger size unchanged and produces one effect.",
      "scenarios": [
        "N02-S020"
      ],
      "rust_tests": [
        "a_retry_storm_leaves_the_queue_and_the_ledger_bounded"
      ]
    },
    {
      "id": "INV-ID-REUSE",
      "claim": "The same command number with different content is refused, while the first is waiting and after it settled.",
      "scenarios": [
        "N02-S008"
      ],
      "rust_tests": [
        "the_same_number_with_different_content_is_refused_everywhere",
        "the_same_number_from_two_peers_is_two_commands"
      ]
    },
    {
      "id": "INV-WINDOW-AGE",
      "claim": "After the retention period an outcome is forgotten, and a retry is answered as unknown (never re-applied).",
      "scenarios": [
        "N02-S003"
      ],
      "rust_tests": [
        "after_retention_a_retry_is_unknown_and_is_not_applied_again",
        "an_entry_expires_exactly_when_its_age_reaches_the_retention",
        "a_clock_that_runs_backwards_cannot_extend_or_shorten_retention"
      ]
    },
    {
      "id": "INV-WINDOW-COUNT",
      "claim": "When the ledger is full the oldest outcome is forgotten explicitly, and newer ones are still answered.",
      "scenarios": [
        "N02-S004"
      ],
      "rust_tests": [
        "a_full_ledger_forgets_the_oldest_and_says_so",
        "at_capacity_the_oldest_is_evicted_and_becomes_explicitly_unknown",
        "a_recorded_command_never_reads_as_unseen_afterwards",
        "memory_stays_bounded_over_a_long_run"
      ]
    },
    {
      "id": "INV-NOT-FOREVER",
      "claim": "Exactly-once is not promised forever: beyond the window the channel reports unknown and does not guess.",
      "scenarios": [
        "N02-S003",
        "N02-S004"
      ],
      "rust_tests": [
        "after_retention_a_retry_is_unknown_and_is_not_applied_again",
        "the_floor_also_covers_a_number_that_was_never_seen_below_an_evicted_one"
      ]
    },
    {
      "id": "INV-STALE-LEADER",
      "claim": "A controller acting under an old epoch changes nothing once the group's epoch has moved on.",
      "scenarios": [
        "N02-S005"
      ],
      "rust_tests": [
        "a_stale_leader_cannot_alter_the_group_after_the_epoch_moves_on"
      ]
    },
    {
      "id": "INV-EPOCH-BINDING",
      "claim": "A key bound to one epoch is refused at the door under any other epoch.",
      "scenarios": [
        "N02-S006"
      ],
      "rust_tests": [
        "a_key_bound_to_one_epoch_is_rejected_at_the_door_under_another"
      ]
    },
    {
      "id": "INV-NO-EPOCH-ADVANCE",
      "claim": "Nothing the channel applies can advance the group's epoch, so a request cannot fence out the legitimate leader.",
      "scenarios": [
        "N02-S006"
      ],
      "rust_tests": [
        "an_epoch_jump_from_a_peer_whose_key_allows_it_still_cannot_fence_out_the_group"
      ]
    },
    {
      "id": "INV-EXPECTED-REVISION",
      "claim": "A command whose expected revision is not the current one is refused with no effect.",
      "scenarios": [
        "N02-S007",
        "N02-S022"
      ],
      "rust_tests": [
        "a_wrong_expected_revision_is_refused_without_effect",
        "a_relative_command_computed_against_an_old_revision_is_not_applied"
      ]
    },
    {
      "id": "INV-EXPIRED-AUTHORITY",
      "claim": "A peer revoked or rebound after its command was accepted has no effect when the command would run.",
      "scenarios": [
        "N02-S005",
        "N02-S014",
        "N02-S015"
      ],
      "rust_tests": [
        "a_peer_revoked_after_acceptance_has_no_effect_when_the_step_runs",
        "rebinding_a_key_after_acceptance_also_expires_the_commands_accepted_under_the_old_binding",
        "revocation_wipes_the_key_stales_snapshots_and_names_the_failure"
      ]
    },
    {
      "id": "INV-BOUNDED-QUEUE",
      "claim": "Every queue is bounded; a full lane refuses new work, and a refusal for want of room does not consume the command number.",
      "scenarios": [
        "N02-S009",
        "N02-S012",
        "N02-S020"
      ],
      "rust_tests": [
        "the_ordinary_lane_is_bounded_and_a_duplicate_of_a_waiting_command_is_still_answered",
        "a_local_stop_runs_in_its_first_step_through_a_full_queue_a_retry_storm_and_a_remote_flood"
      ]
    },
    {
      "id": "INV-REFUSAL-KEEPS-NUMBER",
      "claim": "A request turned away before acceptance can be sent again unchanged once the reason has passed.",
      "scenarios": [
        "N02-S009",
        "N02-S028"
      ],
      "rust_tests": [
        "the_ordinary_lane_is_bounded_and_a_duplicate_of_a_waiting_command_is_still_answered",
        "rate_limits_are_per_peer_and_per_lane_and_report_the_wait"
      ]
    },
    {
      "id": "INV-REFUSAL-RECORDED",
      "claim": "A command refused after acceptance has its refusal recorded as its outcome, and a retry is told the same.",
      "scenarios": [
        "N02-S021",
        "N02-S024"
      ],
      "rust_tests": [
        "relative_volume_clamps_and_an_unknown_member_is_a_recorded_refusal",
        "a_wrong_expected_revision_is_refused_without_effect"
      ]
    },
    {
      "id": "INV-RATE-LIMIT",
      "claim": "Rate limits are per authenticated peer and per lane, and refusals state the exact wait.",
      "scenarios": [
        "N02-S010",
        "N02-S011"
      ],
      "rust_tests": [
        "rate_limits_are_per_peer_and_per_lane_and_report_the_wait",
        "a_new_bucket_is_full_and_spends_its_burst_then_refuses_with_the_exact_wait",
        "a_token_arrives_exactly_on_the_interval_and_not_a_nanosecond_before"
      ]
    },
    {
      "id": "INV-PRIORITY-LANE",
      "claim": "Stop, mute and cancel travel in a separate lane that is served before ordinary work.",
      "scenarios": [
        "N02-S012",
        "N02-S013",
        "N02-S023"
      ],
      "rust_tests": [
        "a_step_applies_at_most_its_budget_priority_first",
        "lanes_put_stop_mute_and_cancel_in_the_priority_lane_only"
      ]
    },
    {
      "id": "INV-LOCAL-STOP-FIRST",
      "claim": "A local stop is applied in the first step after it is accepted, ahead of every queued remote command, through a full queue and a remote flood.",
      "scenarios": [
        "N02-S012"
      ],
      "rust_tests": [
        "a_local_stop_runs_in_its_first_step_through_a_full_queue_a_retry_storm_and_a_remote_flood"
      ]
    },
    {
      "id": "INV-RESERVED-SLOTS",
      "claim": "The local user keeps priority slots a remote peer cannot take, and the lane is still bounded.",
      "scenarios": [
        "N02-S013"
      ],
      "rust_tests": [
        "the_local_user_keeps_reserved_priority_slots_and_a_remote_flood_cannot_take_them"
      ]
    },
    {
      "id": "INV-PRIORITY-NOT-BYPASS",
      "claim": "Priority never bypasses authentication: a forged stop is refused like any forged request.",
      "scenarios": [
        "N02-S019"
      ],
      "rust_tests": [
        "priority_is_not_an_authentication_bypass"
      ]
    },
    {
      "id": "INV-LOCAL-EXEMPT",
      "claim": "The local user is not refused for epoch or expected revision; a remote controller in the same position is.",
      "scenarios": [
        "N02-S018"
      ],
      "rust_tests": [
        "the_local_user_is_never_refused_for_epoch_or_revision_but_a_controller_is"
      ]
    },
    {
      "id": "INV-PENDING-EXPIRY",
      "claim": "An accepted command that waits longer than the pending limit expires unapplied, and that is its recorded outcome.",
      "scenarios": [
        "N02-S016"
      ],
      "rust_tests": [
        "a_command_that_waits_past_the_ttl_expires_unapplied_and_that_is_its_recorded_outcome"
      ]
    },
    {
      "id": "INV-NO-UNBOUNDED-RETRY",
      "claim": "No retry or wait is unbounded: queue time, ledger memory and rate are all limited.",
      "scenarios": [
        "N02-S016"
      ],
      "rust_tests": [
        "a_command_that_waits_past_the_ttl_expires_unapplied_and_that_is_its_recorded_outcome",
        "a_retry_storm_leaves_the_queue_and_the_ledger_bounded",
        "a_configuration_with_a_zero_bound_is_refused"
      ]
    },
    {
      "id": "INV-CANCEL",
      "claim": "Cancel withdraws a waiting ordinary command of the same peer before it commits, and changes nothing after, for another peer, or against a stop.",
      "scenarios": [
        "N02-S017"
      ],
      "rust_tests": [
        "a_cancel_withdraws_a_waiting_command_and_the_retry_is_told_so",
        "a_cancel_that_arrives_too_late_or_too_wrong_changes_nothing",
        "one_peer_cannot_cancel_another_peers_command",
        "a_cancel_of_a_number_the_ledger_forgot_says_so"
      ]
    },
    {
      "id": "INV-RELATIVE-CLAMP",
      "claim": "Relative volume is resolved against the live value in the channel and clamped to 0..=100.",
      "scenarios": [
        "N02-S022"
      ],
      "rust_tests": [
        "relative_volume_clamps_and_an_unknown_member_is_a_recorded_refusal"
      ]
    },
    {
      "id": "INV-STEP-BUDGET",
      "claim": "A step applies at most its budget of commands; the rest wait for the next step.",
      "scenarios": [
        "N02-S023"
      ],
      "rust_tests": [
        "a_step_applies_at_most_its_budget_priority_first"
      ]
    },
    {
      "id": "INV-SESSION-FAULT-INTERNAL",
      "claim": "A session refusal that is not about the command's content (a repeated or out-of-window number, a stale epoch) is an internal fault: counted, kept for the operator, recorded without detail and never shown to the sender. An unknown member is still the sender's.",
      "scenarios": [
        "N02-S024"
      ],
      "rust_tests": [
        "a_number_taken_by_another_caller_is_an_internal_fault_that_clears"
      ]
    },
    {
      "id": "INV-RESTART-FENCE",
      "claim": "After a channel restart against a session that kept running, a copy composed before the restart is refused whatever its kind, nothing is reverted, and a command composed after the restart is applied.",
      "scenarios": [
        "N02-S025"
      ],
      "rust_tests": [
        "after_a_restart_late_absolute_and_relative_copies_are_refused_and_a_fresh_command_applies",
        "the_revision_floor_is_the_session_revision_at_the_first_step"
      ]
    },
    {
      "id": "INV-NUMBER-ABOVE-HIGH-WATER",
      "claim": "A restarted channel numbers its session commands above everything its predecessor used, so the first commands after a restart are not session faults.",
      "scenarios": [
        "N02-S026"
      ],
      "rust_tests": [
        "a_restarted_channel_starts_its_numbers_above_everything_the_session_remembers",
        "the_channels_own_command_numbers_never_collide_with_the_session_even_past_its_window"
      ]
    },
    {
      "id": "INV-ABSOLUTE-REPEATABLE",
      "claim": "Absolute volume stays naturally repeatable: a command composed against an older revision than the current one still applies within an incarnation, so pipelined updates and interleaved controllers are not stale.",
      "scenarios": [
        "N02-S027"
      ],
      "rust_tests": [
        "a_volume_composed_against_an_older_revision_still_applies_within_an_incarnation"
      ]
    },
    {
      "id": "INV-REVISION-REQUIRED",
      "claim": "A remote controller's volume or mute command must name the revision it last read, or it is turned away at the door without consuming its number; stop, cancel and the local user need none.",
      "scenarios": [
        "N02-S028"
      ],
      "rust_tests": [
        "a_controller_must_name_the_revision_it_read_for_volume_and_mute",
        "only_volume_and_mute_setters_need_an_observed_revision_besides_the_relative_ones"
      ]
    },
    {
      "id": "INV-FUTURE-REVISION",
      "claim": "A command naming a revision the session has not reached is refused with no effect.",
      "scenarios": [
        "N02-S028"
      ],
      "rust_tests": [
        "a_revision_the_session_has_not_reached_is_refused",
        "a_wrong_expected_revision_is_refused_without_effect"
      ]
    }
  ],
  "other_rust_checks": {
    "accounting": [
      "every_submit_lands_in_exactly_one_bucket",
      "diagnostics_show_received_beside_committed"
    ],
