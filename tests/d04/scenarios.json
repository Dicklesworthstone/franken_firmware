  {"id": "D04-TIM-001", "what": "steady state: every block is released on the period and finishes in one tick", "ticks": 24, "expect": {"finished": [[0, 2, "on_time"], [1, 6, "on_time"], [2, 10, "on_time"], [3, 14, "on_time"], [4, 18, "on_time"], [5, 22, "on_time"]], "counters": {"blocks_started": 6, "blocks_on_time": 6, "ingress_loss_blocks": 0, "decode_delay_blocks": 0, "cpu_miss_blocks": 0, "capacity_rejected_blocks": 0, "short_write_blocks": 0, "late_wakes": 0, "reserve_breaches": 0, "frames_generated": 384, "frames_submitted": 384, "frames_dropped_late": 0, "frames_dropped_capacity": 0, "frames_discarded_short": 0, "silence_frames_ingress": 0, "silence_frames_decode": 0, "max_cost_ticks": 1, "max_late_ticks": 0, "epoch_resets": 0}, "state": "running", "now": 24}},
  {"id": "D04-TIM-002", "what": "deadline boundary pair: a render ending exactly on its deadline is on time, one tick later is dropped", "ticks": 10, "costs": {"0": 3, "1": 4}, "expect": {"finished": [[0, 4, "on_time"], [1, 9, "cpu_miss:1"], [2, 10, "on_time"]], "counters": {"blocks_started": 3, "blocks_on_time": 2, "ingress_loss_blocks": 0, "decode_delay_blocks": 0, "cpu_miss_blocks": 1, "capacity_rejected_blocks": 0, "short_write_blocks": 0, "late_wakes": 0, "reserve_breaches": 2, "frames_generated": 192, "frames_submitted": 128, "frames_dropped_late": 64, "frames_dropped_capacity": 0, "frames_discarded_short": 0, "silence_frames_ingress": 0, "silence_frames_decode": 0, "max_cost_ticks": 4, "max_late_ticks": 1, "epoch_resets": 0}, "state": "running", "now": 10}},
  {"id": "D04-TIM-003", "what": "timer delay: a late wake-up that still meets the deadline is on time, one that does not is a CPU miss", "ticks": 10, "delays": {"0": 2, "1": 3}, "expect": {"finished": [[0, 4, "on_time"], [1, 9, "cpu_miss:1"], [2, 10, "on_time"]], "counters": {"blocks_started": 3, "blocks_on_time": 2, "ingress_loss_blocks": 0, "decode_delay_blocks": 0, "cpu_miss_blocks": 1, "capacity_rejected_blocks": 0, "short_write_blocks": 0, "late_wakes": 2, "reserve_breaches": 0, "frames_generated": 192, "frames_submitted": 128, "frames_dropped_late": 64, "frames_dropped_capacity": 0, "frames_discarded_short": 0, "silence_frames_ingress": 0, "silence_frames_decode": 0, "max_cost_ticks": 1, "max_late_ticks": 1, "epoch_resets": 0}, "state": "running", "now": 10}},
  {"id": "D04-TIM-004", "what": "a render longer than the period delays the next block instead of overlapping it", "ticks": 10, "costs": {"0": 6}, "expect": {"finished": [[0, 7, "cpu_miss:3"], [1, 8, "on_time"], [2, 10, "on_time"]], "counters": {"blocks_started": 3, "blocks_on_time": 2, "ingress_loss_blocks": 0, "decode_delay_blocks": 0, "cpu_miss_blocks": 1, "capacity_rejected_blocks": 0, "short_write_blocks": 0, "late_wakes": 0, "reserve_breaches": 1, "frames_generated": 192, "frames_submitted": 128, "frames_dropped_late": 64, "frames_dropped_capacity": 0, "frames_discarded_short": 0, "silence_frames_ingress": 0, "silence_frames_decode": 0, "max_cost_ticks": 6, "max_late_ticks": 3, "epoch_resets": 0}, "state": "running", "now": 10}},
  {"id": "D04-TIM-005", "what": "three consecutive CPU misses trip the watchdog; later ticks do nothing", "ticks": 22, "costs": {"0": 6, "1": 6, "2": 6}, "expect": {"finished": [[0, 7, "cpu_miss:3"], [1, 13, "cpu_miss:5"], [2, 19, "cpu_miss:7"]], "counters": {"blocks_started": 3, "blocks_on_time": 0, "ingress_loss_blocks": 0, "decode_delay_blocks": 0, "cpu_miss_blocks": 3, "capacity_rejected_blocks": 0, "short_write_blocks": 0, "late_wakes": 0, "reserve_breaches": 3, "frames_generated": 192, "frames_submitted": 0, "frames_dropped_late": 192, "frames_dropped_capacity": 0, "frames_discarded_short": 0, "silence_frames_ingress": 0, "silence_frames_decode": 0, "max_cost_ticks": 6, "max_late_ticks": 7, "epoch_resets": 0}, "state": "faulted", "now": 19}},
  {"id": "D04-SRC-001", "what": "ingress loss and decode delay are counted apart; only lost content starts a new epoch", "ticks": 24, "starve": {"1": "ingress_loss", "2": "ingress_loss", "4": "decode_delay"}, "expect": {"finished": [[0, 2, "on_time"], [1, 6, "starved:ingress_loss:64"], [2, 10, "starved:ingress_loss:64"], [3, 14, "on_time"], [4, 18, "starved:decode_delay:64"], [5, 22, "on_time"]], "counters": {"blocks_started": 6, "blocks_on_time": 3, "ingress_loss_blocks": 2, "decode_delay_blocks": 1, "cpu_miss_blocks": 0, "capacity_rejected_blocks": 0, "short_write_blocks": 0, "late_wakes": 0, "reserve_breaches": 0, "frames_generated": 384, "frames_submitted": 384, "frames_dropped_late": 0, "frames_dropped_capacity": 0, "frames_discarded_short": 0, "silence_frames_ingress": 128, "silence_frames_decode": 64, "max_cost_ticks": 1, "max_late_ticks": 0, "epoch_resets": 1}, "state": "running", "now": 24}},
