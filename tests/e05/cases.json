  "adverse": [
    {"id": "E05-ADV-01", "why": "a failing hook aborts boot but a watchdog resets it: the attempt counter still bounds the loop",
     "facts": {"hook_failure_nonfatal": false}, "step": "hook_run", "kind": "hook_exits_nonzero",
     "expect": {"verdict": "STOCK_OK", "reason": "attempt_cap", "boots": 4, "violations": []}},
    {"id": "E05-ADV-02", "why": "an unreadable hook aborts boot before the launcher ever counts an attempt: nothing bounds the loop",
     "facts": {"hook_failure_nonfatal": false}, "step": "hook_read", "kind": "hook_unreadable",
     "expect": {"verdict": "FAILED", "reason": "restart_loop_unbounded", "boots": 8, "violations": ["unbounded_restarts"]}},
    {"id": "E05-ADV-03", "why": "a hook that hangs boot with no watchdog coverage has no recovery path",
     "facts": {"watchdog_covers_boot_stall": false}, "step": "hook_run", "kind": "hook_hangs",
     "expect": {"verdict": "FAILED", "reason": "no_recovery_path", "boots": 1, "violations": ["no_recovery_path"]}},
    {"id": "E05-ADV-04", "why": "stock stopped and nothing restarts it: muted forever",
     "facts": {"watchdog_restarts_daemon": false}, "step": "stock_stop", "kind": "stock_stop_fails",
     "expect": {"verdict": "FAILED", "reason": "no_recovery_path", "boots": 1, "violations": ["no_recovery_path"]}},
    {"id": "E05-ADV-05", "why": "the same missing restart path after the custom binary dies",
     "facts": {"watchdog_restarts_daemon": false}, "step": "custom_ready", "kind": "binary_exits_nonzero",
     "expect": {"verdict": "FAILED", "reason": "no_recovery_path", "boots": 1, "violations": ["no_recovery_path"]}},
    {"id": "E05-ADV-06", "why": "stock respawns after being stopped: the launcher yields rather than share the device",
     "facts": {"stock_stop_effective": false}, "step": "boot", "kind": "none",
     "expect": {"verdict": "STOCK_OK", "reason": "stock_respawn_detected", "boots": 1, "violations": []}},
    {"id": "E05-ADV-07", "why": "a hook run without an interpreter needs its exec bit; without it the hook fails like any failure",
     "facts": {"hook_interpreted": false}, "step": "hook_read", "kind": "hook_mode_no_exec",
     "expect": {"verdict": "STOCK_OK", "reason": "hook_not_executable", "boots": 1, "violations": []}},
    {"id": "E05-ADV-08", "why": "a hook that does not block boot can hang in the background without stopping the stock path",
     "facts": {"hook_runs_synchronously": false}, "step": "hook_run", "kind": "hook_hangs",
     "expect": {"verdict": "STOCK_OK", "reason": "hook_hang_async", "boots": 1, "violations": []}},
    {"id": "E05-ADV-09", "why": "rename that is not atomic leaves a half hook even under the atomic discipline",
     "facts": {"fs_rename_atomic": false}, "step": "provision", "kind": "rename",
     "expect": {"verdict": "FAILED", "reason": "partial_hook_executed", "boots": 1, "violations": ["partial_hook_executed"]}},
    {"id": "E05-ADV-10", "why": "an update that does not preserve the hook returns the unit to stock",
     "facts": {"hook_survives_update": false}, "step": "update", "kind": "none",
     "expect": {"verdict": "STOCK_OK", "reason": "hook_absent", "boots": 1, "violations": []}},
    {"id": "E05-ADV-11", "why": "an interrupted update that wipes the hook returns the unit to stock",
     "facts": {"update_interrupted_preserves_hook": false}, "step": "update", "kind": "power_loss",
     "expect": {"verdict": "STOCK_OK", "reason": "hook_absent", "boots": 1, "violations": []}},
    {"id": "E05-ADV-12", "why": "a binary on an exec-capable mount runs even though the writable partition is noexec",
     "facts": {"jffs_noexec": false}, "step": "boot", "kind": "none", "policy": {"binary_location": "jffs"},
     "expect": {"verdict": "CUSTOM_OK", "reason": "custom_owner", "boots": 1, "violations": []}},
    {"id": "E05-ADV-13", "why": "if absence of the hook is not skipped, the boot script runs a missing file: that is a hook failure",
     "facts": {"hook_gate_existence_only": false}, "step": "hook_gate", "kind": "hook_missing",
     "expect": {"verdict": "STOCK_OK", "reason": "hook_absent_unskipped", "boots": 1, "violations": []}}
  ],
  "defects": [
    {"id": "E05-DEF-01", "invariant": "INV-1", "profile": "synthetic-benign", "why": "start custom without waiting for the stock-stop acknowledgement: two owners",
