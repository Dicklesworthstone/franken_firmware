    {"id": "E05-DEF-04", "invariant": "INV-3", "profile": "synthetic-benign", "why": "no attempt cap and no backoff: a hot restart loop",
     "policy": {"backoff": false, "attempt_cap": null}, "step": "owner_commit", "kind": "binary_crashes_after_ready",
     "expect": {"verdict": "FAILED", "violations": ["no_backoff", "unbounded_restarts"]}},
    {"id": "E05-DEF-05", "invariant": "INV-4", "profile": "synthetic-benign", "why": "rewrite the hook in place: power loss leaves a half script that runs",
     "policy": {"atomic_write": false}, "step": "provision", "kind": "write",
     "expect": {"verdict": "FAILED", "violations": ["partial_hook_executed"]}},
    {"id": "E05-DEF-06", "invariant": "INV-2", "profile": "synthetic-benign", "why": "no rollback path after stock was stopped",
     "policy": {"restore_stock": false}, "step": "custom_ready", "kind": "binary_exits_nonzero",
     "expect": {"verdict": "FAILED", "violations": ["no_recovery_path"]}},
    {"id": "E05-DEF-07", "invariant": "INV-5", "profile": "synthetic-benign", "why": "transitions and rollbacks carry no reason",
     "policy": {"log_reasons": false}, "step": "preflight", "kind": "binary_missing",
     "expect": {"verdict": "STOCK_OK", "violations": ["missing_reason"]}},
    {"id": "E05-DEF-08", "invariant": "PRED", "profile": "synthetic-benign", "why": "report the service as started because the hook exists",
     "policy": {"claim_from_presence": true}, "step": "custom_ready", "kind": "binary_exits_nonzero",
     "expect": {"verdict": "STOCK_OK", "violations": ["unsupported_claim"]}},
    {"id": "E05-DEF-09", "invariant": "INV-6", "profile": "57.23", "why": "read an unknown fact as fine: the run reports success it cannot know",
     "policy": {"strict_unknown": false}, "step": "boot", "kind": "none",
     "expect": {"verdict": "CUSTOM_OK", "violations": ["unknown_resolved_ok"]}}
  ],
  "contrasts": [
    {"id": "E05-CON-01", "why": "preflight turns a launcher-side failure into a definite, safe outcome on the real image; without it the same failure is unqualifiable because stock was already stopped",
     "profile": "57.23", "step": "preflight", "kind": "binary_missing",
     "with": {"policy": {}, "expect": {"verdict": "STOCK_OK", "reason": "binary_missing"}},
     "without": {"policy": {"preflight": false}, "expect": {"verdict": "UNQUALIFIED", "blockers": ["EXT-E05-STOP"]}}}
  ]
